---
/**
 * src/layouts/Layout.astro
 * Layout principal — Esprit Aloé
 * Polices auto-hébergées via fontsource (suppression Google Fonts)
 */
import '../styles/global.css';
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/500.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/mulish/400.css';
import '@fontsource/mulish/500.css';
import '@fontsource/mulish/600.css';
import '@fontsource/mulish/700.css';
import frauncesTitres from '@fontsource/fraunces/files/fraunces-latin-500-normal.woff2?url';
import mulishTexte from '@fontsource/mulish/files/mulish-latin-400-normal.woff2?url';
import PopupRemise from '../components/PopupRemise.astro';
import { OFFRE_PERMANENTE, OFFRE_EN_COURS } from '../data/offres';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import MesureUmami from '../components/MesureUmami.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = "Esprit Aloé — Produits Aloe Vera Forever Living France",
  description = "Découvrez et commandez les produits Aloe Vera Forever Living en France. Boissons, soins beauté, programmes détox C9 & DX4. Distributeur certifié, livraison 48–72h. Commande en ligne 7j/7.",
  image = "/og-image.jpg",
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${Astro.site}#website`,
      url: Astro.site,
      name: "Esprit Aloé",
      publisher: { "@id": `${Astro.site}#organization` },
      inLanguage: "fr-FR",
    },
    {
      "@type": "Organization",
      "@id": `${Astro.site}#organization`,
      name: "Esprit Aloé",
      url: Astro.site,
      logo: {
        "@type": "ImageObject",
        url: new URL("/logo.png", Astro.site).href,
        width: 512,
        height: 512,
      },
      contactPoint: {
        "@type": "ContactPoint",
        telephone: "+33677352226",
        contactType: "customer service",
        availableLanguage: "French",
      },
      email: "contact@espritaloe.fr",
      address: {
        "@type": "PostalAddress",
        streetAddress: "98 rue de Bais",
        addressLocality: "Saint-Joachim",
        postalCode: "44720",
        addressRegion: "Pays de la Loire",
        addressCountry: "FR",
      },
      founder: { "@id": `${Astro.site}a-propos/#rafael-avenard` },
      sameAs: [
        "https://www.facebook.com/RafaelAvenardDistributeurForever",
        "https://www.instagram.com/esprit.aloe/",
        "https://maps.app.goo.gl/tBmMFpfawmBnbyzF6",
      ],
    },
  ],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <!-- Polices des titres et du texte : préchargées pour limiter le décalage de mise en page (CLS) -->
    <link rel="preload" href={frauncesTitres} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={mulishTexte} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Esprit Aloé" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org Organisation + WebSite (toutes les pages) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

    <!-- Slot pour JSON-LD spécifiques aux pages (FAQPage, Product, Article…) -->
    <slot name="head" />

    <!-- Mesure d'audience sans cookie (exemptée de consentement) -->
    <MesureUmami />

  </head>
  <body>
    <slot />

    <!-- Popup promo -15% -->
    {OFFRE_EN_COURS && <PopupRemise />}
    <PopupRemise offre={OFFRE_PERMANENTE} secours />

    <AnalyticsConsent />
  </body>
</html>
