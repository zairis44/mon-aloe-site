---
/**
 * src/components/BandeauOffre.astro
 * Bandeau discret « Offre du moment », sous l'en-tête (accueil + fiches produit).
 * Source : src/data/offres.ts. Priorité à l'offre datée (OFFRE_EN_COURS) ;
 * en dehors de sa période, l'offre de bienvenue permanente prend le relais.
 *
 * - Au build : seule l'offre active à ce moment-là est visible.
 * - Dans le navigateur : le choix est refait selon la date du jour,
 *   sans rebuild le jour de la fin d'une offre.
 */
import { OFFRE_EN_COURS, OFFRE_PERMANENTE, type Offre } from '../data/offres';

const maintenant = Date.now();
const actif = (o: { debut: string; fin: string }) => maintenant >= Date.parse(o.debut) && maintenant <= Date.parse(o.fin);
const offres = [OFFRE_EN_COURS, OFFRE_PERMANENTE].filter((o): o is Offre => o !== null && maintenant <= Date.parse(o.fin));
const indexVisible = offres.findIndex(actif);
---

{offres.map((o, i) => {
  const sombre = o.theme === 'blackfriday';
  return (
    <div
      data-bandeau-offre
      data-debut={o.debut}
      data-fin={o.fin}
      hidden={i !== indexVisible}
      class:list={[
        'text-center text-sm px-4 py-2.5',
        sombre ? 'bg-[#141414] text-[#f3e3bd]' : 'bg-aloe-700 text-cream',
      ]}
    >
      <a href="/code-promo-forever/" class="hover:underline underline-offset-4">
        <strong class={sombre ? 'text-[#d4a64a]' : ''}>{o.nom}</strong> :
        −{o.remise} sur votre première commande avec le code
        <strong class="tracking-wide">{o.code}</strong>, dès {o.minimum}{o.finTexte ? `, jusqu'au ${o.finTexte.replace(/ \d{4}$/, '')}` : ''}.
        <span class="whitespace-nowrap font-semibold">Voir l'offre →</span>
      </a>
    </div>
  );
})}

<script>
  const bandeaux = [...document.querySelectorAll<HTMLElement>('[data-bandeau-offre]')];
  const now = Date.now();
  const actif = (b: HTMLElement) => {
    const debut = Date.parse(b.dataset.debut || '');
    const fin = Date.parse(b.dataset.fin || '');
    return !(debut && now < debut) && !(fin && now > fin);
  };
  const choisi = bandeaux.find(actif);
  bandeaux.forEach((b) => (b === choisi ? (b.hidden = false) : b.remove()));
</script>
