---
/**
 * src/components/ProduitsAssocies.astro
 * Bloc « À associer avec ce produit » en bas de fiche produit.
 * Données : src/data/maillage.ts (ASSOCIATIONS + LIBELLES). Zéro JS.
 * Chaque lien : texte d'ancre descriptif (libellé court) + une phrase de contexte.
 */
import { getCollection } from 'astro:content';
import { ASSOCIATIONS, LIBELLES } from '../data/maillage';

export interface Props {
  slug: string;
}

const { slug } = Astro.props;

const produits = await getCollection('produits');
const parSlug = new Map(produits.map((p) => [(p.data as any).slug as string, p.data as any]));

const liens = (ASSOCIATIONS[slug] ?? [])
  .map(([cible, raison]) => {
    const p = parSlug.get(cible);
    if (!p) {
      throw new Error(
        `maillage.ts : la fiche « ${cible} » (associée à « ${slug} ») n'existe pas dans src/content/produits.`,
      );
    }
    return { slug: cible, label: LIBELLES[cible] ?? p.name, raison, image: p.image as string | undefined, nom: p.name as string, disponible: p.disponible !== false };
  })
  .filter((l) => l.disponible);
---

{liens.length > 0 && (
  <section class="bg-white py-14 border-t border-aloe-100" aria-labelledby="produits-associes-titre">
    <div class="mx-auto max-w-6xl px-6">
      <h2 id="produits-associes-titre" class="text-2xl text-aloe-900 mb-8">
        À associer avec ce produit
      </h2>
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {liens.map((l) => (
          <li>
            <a
              href={`/produits/${l.slug}/`}
              class="group flex h-full flex-col rounded-2xl border border-aloe-100 bg-cream p-5 transition-all hover:border-aloe-300 hover:shadow-sm"
            >
              {l.image && (
                <div class="mb-4 flex h-28 items-center justify-center rounded-xl bg-white p-2">
                  <img
                    src={l.image}
                    alt={l.nom}
                    width="120"
                    height="112"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-contain"
                  />
                </div>
              )}
              <span class="mb-1 text-sm font-semibold leading-snug text-aloe-800 group-hover:text-aloe-600">
                {l.label}
              </span>
              <span class="text-xs leading-relaxed text-aloe-500">{l.raison}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
