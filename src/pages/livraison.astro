---
/**
 * src/pages/livraison.astro
 * Page informations de livraison — Esprit Aloé
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const faqLivraison = [
  {
    q: "Livrez-vous en dehors de la France métropolitaine ?",
    r: "Oui, nous livrons en France métropolitaine, en Corse, et dans les DOM-TOM. Les délais peuvent être légèrement plus longs pour les territoires d'outremer. Contactez-nous pour un devis livraison spécifique.",
  },
  {
    q: "Que faire si mon colis est endommagé à la réception ?",
    r: "En cas de colis endommagé, refusez la livraison ou émettez des réserves auprès du transporteur, et contactez-nous immédiatement au 06 77 35 22 26. Nous procéderons à une réexpédition sans frais.",
  },
  {
    q: "Puis-je modifier ou annuler ma commande après validation ?",
    r: "Oui, si votre commande n'est pas encore expédiée. Contactez-nous dès que possible au 06 77 35 22 26 ou par email. Une fois le colis remis au transporteur, la commande ne peut plus être modifiée.",
  },
  {
    q: "Quel est le délai pour un retour ou un remboursement ?",
    r: "Vous disposez de 30 jours à compter de la réception pour retourner un produit. Le remboursement est effectué dans les 14 jours suivant la réception du retour, sur le moyen de paiement initial.",
  },
];
---

<Layout
  title="Livraison & retours — Commande Forever Living France | Esprit Aloé"
  description="Informations de livraison pour vos commandes Forever Living : relais pickup 48-72h dès 4€, livraison à domicile Chronopost J+1 à 13€, gratuit dès 150€. Partout en France."
  canonical="https://espritaloe.fr/livraison/"
>
  <Header />

  <!-- EN-TÊTE -->
  <section class="bg-gradient-to-br from-aloe-50 via-cream to-sand py-12">
    <div class="mx-auto max-w-6xl px-6">
      <nav class="text-xs text-aloe-400 mb-6" aria-label="Fil d'Ariane">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-aloe-600 transition-colors">Accueil</a></li>
          <li>›</li>
          <li class="text-aloe-700 font-medium">Livraison & Retours</li>
        </ol>
      </nav>
      <h1 class="text-4xl text-aloe-900 mb-4">Livraison & Retours</h1>
      <p class="text-lg text-aloe-600 max-w-xl">
        Commandez en toute confiance. Livraison rapide partout en France,
        retours sans tracas sous 30 jours.
      </p>
    </div>
  </section>

  <!-- BLOCS RÉSUMÉ -->
  <section class="bg-cream py-16">
    <div class="mx-auto max-w-6xl px-6 grid md:grid-cols-3 gap-6 mb-16">
      <div class="rounded-2xl bg-white border border-aloe-100 p-7 text-center">
        <span class="text-4xl block mb-4">📦</span>
        <p class="text-xs font-semibold uppercase tracking-widest text-aloe-400 mb-2">Point relais</p>
        <h2 class="text-lg font-semibold text-aloe-800 mb-3">Livraison en relais</h2>
        <p class="text-sm text-aloe-600 leading-relaxed">48h à 72h après expédition. Commande passée avant 12h45. Délai de retrait : 7 jours.</p>
      </div>
      <div class="rounded-2xl bg-white border border-aloe-100 p-7 text-center">
        <span class="text-4xl block mb-4">🚚</span>
        <p class="text-xs font-semibold uppercase tracking-widest text-aloe-400 mb-2">À domicile</p>
        <h2 class="text-lg font-semibold text-aloe-800 mb-3">Chronopost J+1</h2>
        <p class="text-sm text-aloe-600 leading-relaxed">Livraison le lendemain pour toute commande passée avant 12h45. Pas de livraison le samedi.</p>
      </div>
      <div class="rounded-2xl bg-white border border-aloe-100 p-7 text-center">
        <span class="text-4xl block mb-4">🎁</span>
        <p class="text-xs font-semibold uppercase tracking-widest text-aloe-400 mb-2">Offerte</p>
        <h2 class="text-lg font-semibold text-aloe-800 mb-3">Livraison gratuite</h2>
        <p class="text-sm text-aloe-600 leading-relaxed">Livraison en relais offerte pour toute commande à partir de 150 € TTC.</p>
      </div>
    </div>

    <!-- TABLEAUX TARIFS -->
    <div class="mx-auto max-w-3xl px-6 space-y-10">

      <!-- Relais Pickup -->
      <div>
        <h2 class="text-2xl text-aloe-900 mb-2">📦 Livraison en point relais</h2>
        <p class="text-sm text-aloe-500 mb-4">Livraison en 48h à 72h pour toute commande passée avant 12h45 — délai de 7 jours pour retirer votre commande.</p>
        <div class="rounded-2xl overflow-hidden border border-aloe-100">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-aloe-800 text-cream">
                <th class="text-left px-6 py-4 font-semibold">Montant de la commande</th>
                <th class="text-right px-6 py-4 font-semibold">Frais de port</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-aloe-100">
              <tr class="bg-white">
                <td class="px-6 py-4 text-aloe-700">Moins de 50 € TTC</td>
                <td class="px-6 py-4 text-right text-aloe-700">8,00 €</td>
              </tr>
              <tr class="bg-aloe-50">
                <td class="px-6 py-4 text-aloe-700">De 50 € à 150 € TTC</td>
                <td class="px-6 py-4 text-right text-aloe-700">4,00 €</td>
              </tr>
              <tr class="bg-white">
                <td class="px-6 py-4 text-aloe-700 font-semibold">À partir de 150 € TTC</td>
                <td class="px-6 py-4 text-right text-aloe-600 font-semibold">🎁 Gratuit</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Chronopost -->
      <div>
        <h2 class="text-2xl text-aloe-900 mb-2">🚚 Livraison à domicile — Chronopost</h2>
        <p class="text-sm text-aloe-500 mb-4">Livraison J+1 pour toute commande passée avant 12h45 — pas de livraison le samedi.</p>
        <div class="rounded-2xl overflow-hidden border border-aloe-100">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-aloe-800 text-cream">
                <th class="text-left px-6 py-4 font-semibold">Mode de livraison</th>
                <th class="text-right px-6 py-4 font-semibold">Tarif fixe</th>
              </tr>
            </thead>
            <tbody>
              <tr class="bg-white">
                <td class="px-6 py-4 text-aloe-700">Livraison à domicile ou à une autre adresse</td>
                <td class="px-6 py-4 text-right text-aloe-700 font-semibold">13,00 €</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-xs text-aloe-400 mt-3">Tarifs TTC valables pour la France métropolitaine. Contactez-nous pour les DOM-TOM.</p>
      </div>

      <!-- Politique de retour -->
      <div>
        <h2 class="text-2xl text-aloe-900 mb-6">Politique de retour — 30 jours satisfait ou remboursé</h2>
        <div class="space-y-4 text-aloe-700 leading-relaxed">
          <p>
            Nous sommes convaincus de la qualité des produits Forever Living. Si pour quelque raison
            que ce soit vous n'êtes pas satisfait(e), vous disposez de <strong>30 jours</strong> à
            compter de la réception pour nous retourner le produit.
          </p>
          <p>
            Les produits retournés doivent être dans leur état d'origine (emballage intact ou
            produit peu entamé). Les frais de retour sont à votre charge, sauf en cas d'erreur
            de notre part ou de produit défectueux.
          </p>
          <p>
            Pour initier un retour, contactez-nous au <a href="tel:+33677352226" class="text-aloe-600 underline">06 77 35 22 26</a>
            ou par email à <a href="mailto:contact@espritaloe.fr" class="text-aloe-600 underline">contact@espritaloe.fr</a>.
            Nous vous guiderons pas à pas.
          </p>
        </div>
      </div>

      <!-- FAQ -->
      <div>
        <h2 class="text-2xl text-aloe-900 mb-6">Questions fréquentes</h2>
        <div class="space-y-3">
          {faqLivraison.map((item) => (
            <details class="group rounded-2xl bg-white border border-aloe-100 overflow-hidden" name="faq-livraison">
              <summary class="flex cursor-pointer items-center justify-between p-5 font-semibold text-aloe-800 hover:bg-aloe-50 transition-colors list-none">
                <span>{item.q}</span>
                <span class="ml-4 flex-shrink-0 text-aloe-400 transition-transform group-open:rotate-45 text-xl leading-none">+</span>
              </summary>
              <div class="px-5 pb-5 text-sm text-aloe-600 leading-relaxed border-t border-aloe-100 pt-4">
                {item.r}
              </div>
            </details>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="bg-sand py-14">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl text-aloe-900 mb-4">Une question sur votre commande ?</h2>
      <p class="text-aloe-600 mb-6">Rafael est disponible 7j/7 pour vous aider.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="tel:+33677352226" class="rounded-full bg-aloe-600 px-8 py-3.5 text-sm font-semibold text-cream hover:bg-aloe-700 transition-colors">
          📞 06 77 35 22 26
        </a>
        <a href="/contact/" class="rounded-full border border-aloe-300 px-8 py-3.5 text-sm font-semibold text-aloe-700 hover:bg-aloe-50 transition-colors">
          Formulaire de contact
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
