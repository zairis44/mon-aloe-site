---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CtaCommander from '../../components/CtaCommander.astro';

export async function getStaticPaths() {
  const articles = await getCollection('blog', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, seoTitle, pubDate, updatedDate, author, image, imageAlt, category, produitsLies, articlesLies, faq } = article.data;
const pageTitle = seoTitle ? `${seoTitle} | Esprit Aloé` : `${title} | Esprit Aloé`;

const siteUrl = 'https://espritaloe.fr';
const articleUrl = `${siteUrl}/blog/${article.id}/`;

// Enrichissement produits
const allProduits = await getCollection('produits');
const produitsAvecDetails = produitsLies.map((p: any) => {
  const found = allProduits.find((prod) => prod.data.slug === p.slug);
  return {
    slug: p.slug,
    nom: p.nom,
    price: found?.data.price ?? null,
    lienCommande: found?.data.lienCommande ?? null,
  };
});

const schemaArticle = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  url: articleUrl,
  image: image ? `${siteUrl}${image}` : undefined,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    "@type": "Person",
    name: author,
    url: `${siteUrl}/a-propos/`,
  },
  publisher: { "@id": `${siteUrl}/#organization` },
  inLanguage: "fr-FR",
};

// Schema FAQPage — injecté uniquement si l'article a un bloc faq: en frontmatter
const schemaFAQ = faq && faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item: { question: string; reponse: string }) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.reponse,
    },
  })),
} : null;

const categoryLabels: Record<string, string> = {
  'boissons-aloe-vera': 'Boissons Aloe Vera',
  'beaute': 'Beauté & Bien-être',
  'beaute-bien-etre': 'Beauté & Bien-être',
  'programmes-detox': 'Programmes Détox',
  'sport': 'Sport & Fitness',
  'sport-et-fitness': 'Sport & Fitness',
  'bien-etre': 'Bien-être',
  'nutrition': 'Nutrition',
  'guides': 'Guides',
};

const readingTime = Math.max(1, Math.ceil((article.body?.split(' ').length ?? 0) / 200));
---

<Layout
  title={pageTitle}
  description={description}
  image={image}
  canonical={articleUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} slot="head" />
  {schemaFAQ && <script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} slot="head" />}

  <Header />

  <article>

    <!-- ══ EN-TÊTE : fond coloré, centré, aéré ══ -->
    <header class="bg-gradient-to-b from-aloe-800 to-aloe-900 py-20">
      <div class="mx-auto max-w-2xl px-6 text-center">
        <nav class="text-xs text-aloe-400 mb-8" aria-label="Fil d'Ariane">
          <ol class="flex items-center justify-center gap-2">
            <li><a href="/" class="hover:text-aloe-200 transition-colors">Accueil</a></li>
            <li class="text-aloe-600">›</li>
            <li><a href="/blog/" class="hover:text-aloe-200 transition-colors">Blog</a></li>
            <li class="text-aloe-600">›</li>
            <li class="text-aloe-300 truncate max-w-[200px]">{title}</li>
          </ol>
        </nav>

        <span class="inline-block rounded-full bg-aloe-700 px-4 py-1.5 text-xs font-semibold text-aloe-200 uppercase tracking-widest mb-6">
          {categoryLabels[category] ?? category}
        </span>

        <h1 class="text-3xl md:text-4xl text-cream leading-tight mb-6 font-display">{title}</h1>
        <p class="text-lg text-aloe-200 leading-relaxed mb-8">{description}</p>

        <div class="flex items-center justify-center gap-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-aloe-600 flex items-center justify-center text-cream font-bold text-sm flex-shrink-0">RA</div>
            <div class="text-left">
              <p class="text-sm font-semibold text-cream">{author}</p>
              <time class="text-xs text-aloe-400" datetime={(updatedDate ?? pubDate).toISOString()}>
                {updatedDate
                  ? `Mis à jour le ${updatedDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}`
                  : pubDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
            </div>
          </div>
          <span class="text-aloe-600">·</span>
          <span class="text-xs text-aloe-400">{readingTime} min de lecture</span>
        </div>
      </div>
    </header>

    <!-- ══ IMAGE HERO — pleine largeur, impact fort ══ -->
    {image && (
      <div class="bg-aloe-900">
        <div class="mx-auto max-w-4xl">
          <img
            src={image}
            alt={imageAlt ?? title}
            width="1200"
            height="600"
            loading="eager"
            class="w-full object-cover max-h-[500px]"
          />
        </div>
      </div>
    )}

    <!-- ══ CORPS DE L'ARTICLE + SIDEBAR ══ -->
    <div class="bg-white py-16">
      <div class="mx-auto max-w-6xl px-6">
        <div class="grid lg:grid-cols-[1fr_300px] gap-16 items-start">

          <!-- Contenu texte — max-width contraint pour lisibilité -->
          <div class="min-w-0">
            <div class="prose max-w-[680px]
              prose-headings:font-display
              prose-h2:text-2xl prose-h2:text-aloe-900 prose-h2:mt-14 prose-h2:mb-5 prose-h2:pb-3 prose-h2:border-b prose-h2:border-aloe-100
              prose-h3:text-xl prose-h3:text-aloe-800 prose-h3:mt-10 prose-h3:mb-4
              prose-p:text-aloe-700 prose-p:leading-[1.9] prose-p:text-[17px] prose-p:mb-6
              prose-a:text-aloe-600 prose-a:underline prose-a:underline-offset-2 hover:prose-a:text-aloe-800
              prose-strong:text-aloe-900 prose-strong:font-semibold
              prose-ul:text-aloe-700 prose-ul:space-y-2 prose-ul:my-6
              prose-ol:text-aloe-700 prose-ol:space-y-2 prose-ol:my-6
              prose-li:leading-relaxed prose-li:text-[17px]
              prose-blockquote:border-l-4 prose-blockquote:border-aloe-300 prose-blockquote:bg-aloe-50 prose-blockquote:rounded-r-xl prose-blockquote:py-4 prose-blockquote:px-6 prose-blockquote:text-aloe-600 prose-blockquote:not-italic prose-blockquote:my-8
              prose-table:text-sm prose-table:w-full
              prose-img:rounded-2xl prose-img:shadow-md prose-img:my-8
              prose-hr:border-aloe-100 prose-hr:my-12">
              <Content />
            </div>
          </div>

          <!-- Sidebar sticky -->
          {produitsAvecDetails.length > 0 && (
            <aside class="hidden lg:block sticky top-24 self-start space-y-5">
              <div class="rounded-2xl bg-aloe-800 p-6 text-cream">
                <p class="text-[11px] font-semibold uppercase tracking-widest text-aloe-300 mb-5">Produits recommandés</p>
                <div class="space-y-5">
                  {produitsAvecDetails.map((p: any) => (
                    <div class="border-b border-aloe-700 pb-5 last:border-0 last:pb-0">
                      <p class="text-sm font-semibold text-cream mb-1 leading-snug">{p.nom}</p>
                      {p.price && (
                        <p class="text-2xl font-display text-aloe-200 mb-3">{p.price.toFixed(2)} €</p>
                      )}
                      <div class="flex flex-col gap-2">
                        {p.lienCommande && (
                          <CtaCommander lienCommande={p.lienCommande} fullWidth size="sm" label="Commander" />
                        )}
                        <a href={`/produits/${p.slug}/`}
                          class="block text-center text-xs text-aloe-400 hover:text-aloe-200 transition-colors">
                          Voir la fiche
                        </a>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Conseil Rafael -->
              <div class="rounded-2xl border border-aloe-100 p-5 bg-aloe-50">
                <p class="text-sm font-semibold text-aloe-800 mb-1">Un doute ?</p>
                <p class="text-xs text-aloe-500 mb-4 leading-relaxed">Rafael vous conseille gratuitement selon votre profil.</p>
                <a href="tel:+33677352226"
                  class="block text-center rounded-full border border-aloe-300 bg-white px-4 py-2.5 text-sm font-semibold text-aloe-700 hover:bg-aloe-50 transition-colors">
                  📞 06 77 35 22 26
                </a>
              </div>
            </aside>
          )}
        </div>
      </div>
    </div>

    <!-- ══ PRODUITS MOBILE (sous l'article) ══ -->
    {produitsAvecDetails.length > 0 && (
      <div class="bg-aloe-50 py-12 lg:hidden">
        <div class="mx-auto max-w-3xl px-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-aloe-500 mb-6 text-center">Produits mentionnés dans cet article</p>
          <div class="grid sm:grid-cols-2 gap-5">
            {produitsAvecDetails.map((p: any) => (
              <div class="rounded-2xl bg-white border border-aloe-100 p-6 flex flex-col shadow-sm">
                <p class="text-sm font-semibold text-aloe-800 mb-2 leading-snug">{p.nom}</p>
                {p.price && <p class="text-2xl font-display text-aloe-700 mb-5">{p.price.toFixed(2)} €</p>}
                <div class="mt-auto flex flex-col gap-2">
                  {p.lienCommande && (
                    <CtaCommander lienCommande={p.lienCommande} fullWidth label="Commander" />
                  )}
                  <a href={`/produits/${p.slug}/`}
                    class="block text-center text-xs text-aloe-500 hover:text-aloe-700 transition-colors py-1">
                    Voir la fiche →
                  </a>
                </div>
              </div>
            ))}
          </div>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-5 text-xs text-aloe-400">
            <span>✓ Certifié IASC</span>
            <span>✓ Livraison 48–72h</span>
            <span>✓ Remboursé 30j</span>
          </div>
        </div>
      </div>
    )}

    <!-- ══ ARTICLES LIÉS ══ -->
    {articlesLies.length > 0 && (
      <div class="bg-aloe-50 border-t border-aloe-100 py-12">
        <div class="mx-auto max-w-3xl px-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-aloe-500 mb-6">À lire aussi</p>
          <div class="grid sm:grid-cols-2 gap-4">
            {articlesLies.map((a: any) => (
              <a href={`/blog/${a.slug}/`}
                class="flex items-center gap-3 rounded-2xl bg-white border border-aloe-100 p-5 hover:border-aloe-300 hover:shadow-sm transition-all group">
                <span class="text-2xl flex-shrink-0">🌿</span>
                <p class="text-sm font-medium text-aloe-800 group-hover:text-aloe-600 leading-snug transition-colors">{a.titre}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    )}

    <!-- ══ BIO AUTEUR ══ -->
    <div class="bg-white border-t border-aloe-100 py-12">
      <div class="mx-auto max-w-2xl px-6">
        <div class="flex items-start gap-5 rounded-2xl bg-aloe-50 border border-aloe-100 p-7">
          <img
            src="/images/rafael-avenard.webp"
            alt="Rafael Avenard, distributeur Forever Living"
            width="64"
            height="64"
            loading="lazy"
            class="w-16 h-16 rounded-2xl object-cover flex-shrink-0"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
          />
          <div class="w-16 h-16 rounded-2xl bg-aloe-600 items-center justify-center text-cream font-bold text-xl flex-shrink-0 hidden">RA</div>
          <div>
            <p class="font-semibold text-aloe-900 mb-1">{author}</p>
            <p class="text-xs text-aloe-500 mb-3">Distributeur indépendant Forever Living Products · Loire-Atlantique</p>
            <p class="text-sm text-aloe-600 leading-relaxed mb-4">Rafael partage son expertise des produits Aloe Vera pour vous guider vers les solutions adaptées. Disponible 7j/7 pour un conseil gratuit.</p>
            <a href="/contact/" class="inline-flex items-center gap-1 text-sm font-semibold text-aloe-600 hover:text-aloe-800 transition-colors">
              Contacter Rafael →
            </a>
          </div>
        </div>
      </div>
    </div>

  </article>

  <Footer />
</Layout>
