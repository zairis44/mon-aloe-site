---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const articles = await getCollection('blog', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, pubDate, updatedDate, author, image, imageAlt, category, produitsLies } = article.data;

const siteUrl = 'https://espritaloe.fr';
const articleUrl = `${siteUrl}/blog/${article.id}/`;

// Enrichissement : récupérer prix + lienCommande depuis la collection produits
const allProduits = await getCollection('produits');
const produitsAvecDetails = produitsLies.map((p: any) => {
  const found = allProduits.find((prod) => prod.data.slug === p.slug);
  return {
    slug: p.slug,
    nom: p.nom,
    price: found?.data.price ?? null,
    lienCommande: found?.data.lienCommande ?? null,
  };
});

const schemaArticle = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  url: articleUrl,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    "@type": "Person",
    name: author,
    url: `${siteUrl}/a-propos/`,
  },
  publisher: { "@id": `${siteUrl}/#organization` },
  inLanguage: "fr-FR",
};

const categoryLabels: Record<string, string> = {
  'boissons-aloe-vera': 'Boissons Aloe Vera',
  'beaute-bien-etre': 'Beauté & Bien-être',
  'programmes-detox': 'Programmes Détox',
  'sport-et-fitness': 'Sport & Fitness',
  'nutrition': 'Nutrition',
  'guides': 'Guides',
};
---

<Layout
  title={`${title} | Blog Esprit Aloé`}
  description={description}
  image={image}
  canonical={articleUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} slot="head" />

  <Header />

  <article>
    <header class="bg-gradient-to-br from-aloe-50 via-cream to-sand py-14">
      <div class="mx-auto max-w-3xl px-6">
        <nav class="text-xs text-aloe-400 mb-6" aria-label="Fil d'Ariane">
          <ol class="flex items-center gap-2">
            <li><a href="/" class="hover:text-aloe-600 transition-colors">Accueil</a></li>
            <li>›</li>
            <li><a href="/blog/" class="hover:text-aloe-600 transition-colors">Blog</a></li>
            <li>›</li>
            <li class="text-aloe-700 font-medium truncate">{title}</li>
          </ol>
        </nav>
        <span class="inline-block rounded-full bg-aloe-100 px-3 py-1 text-xs font-semibold text-aloe-700 uppercase tracking-widest mb-4">
          {categoryLabels[category] ?? category}
        </span>
        <h1 class="text-3xl md:text-5xl text-aloe-900 leading-tight mb-4">{title}</h1>
        <p class="text-lg text-aloe-600 leading-relaxed mb-6">{description}</p>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-aloe-600 flex items-center justify-center text-cream font-bold text-sm flex-shrink-0">RA</div>
          <div>
            <p class="text-sm font-semibold text-aloe-800">{author}</p>
            <time class="text-xs text-aloe-400" datetime={pubDate.toISOString()}>
              {pubDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
          </div>
        </div>
      </div>
    </header>

    {image && (
      <div class="bg-aloe-50">
        <div class="mx-auto max-w-3xl px-6 py-6">
          <img src={image} alt={imageAlt ?? title} width="800" height="450"
            loading="eager" class="rounded-2xl w-full object-cover shadow-lg" />
        </div>
      </div>
    )}

    <div class="bg-cream py-12">
      <div class="mx-auto max-w-6xl px-6 grid lg:grid-cols-[1fr_280px] gap-12">
        <div class="prose prose-aloe max-w-none
          prose-headings:text-aloe-900
          prose-h2:text-3xl prose-h2:mt-10 prose-h2:mb-4
          prose-h3:text-xl prose-h3:mt-6 prose-h3:mb-3
          prose-p:text-aloe-700 prose-p:leading-relaxed
          prose-a:text-aloe-600 prose-a:underline
          prose-strong:text-aloe-800
          prose-ul:text-aloe-700
          prose-blockquote:border-aloe-300 prose-blockquote:text-aloe-600
          prose-table:text-sm">
          <Content />
        </div>

        {produitsAvecDetails.length > 0 && (
          <aside class="lg:sticky lg:top-24 self-start space-y-4">
            <div class="rounded-2xl bg-aloe-800 p-6 text-cream">
              <p class="text-xs font-semibold uppercase tracking-widest text-aloe-300 mb-4">Produits recommandés</p>
              <div class="space-y-4">
                {produitsAvecDetails.map((p: any) => (
                  <div class="rounded-xl bg-aloe-700/60 p-4">
                    <p class="text-sm font-semibold text-cream mb-1 leading-snug">{p.nom}</p>
                    {p.price && (
                      <p class="text-lg font-display text-aloe-200 mb-3">{p.price.toFixed(2)} €</p>
                    )}
                    <div class="flex flex-col gap-2">
                      {p.lienCommande && (
                        <a
                          href={p.lienCommande}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="block text-center rounded-full bg-aloe-500 hover:bg-aloe-400 px-4 py-2 text-xs font-semibold text-cream transition-colors"
                        >
                          Commander directement →
                        </a>
                      )}
                      <a
                        href={`/produits/${p.slug}/`}
                        class="block text-center rounded-full border border-aloe-500 px-4 py-2 text-xs font-medium text-aloe-200 hover:text-cream transition-colors"
                      >
                        Voir la fiche produit
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            </div>
            <div class="rounded-2xl bg-white border border-aloe-100 p-5">
              <p class="text-sm font-semibold text-aloe-800 mb-1">Un doute sur le produit ?</p>
              <p class="text-xs text-aloe-500 mb-3 leading-relaxed">Rafael vous conseille gratuitement selon votre situation.</p>
              <a href="tel:+33677352226" class="block text-center rounded-full border border-aloe-300 px-4 py-2.5 text-sm font-semibold text-aloe-700 hover:bg-aloe-50 transition-colors">
                📞 06 77 35 22 26
              </a>
            </div>
          </aside>
        )}
      </div>
    </div>

    {produitsAvecDetails.length > 0 && (
      <div class="bg-aloe-50 py-10 lg:hidden">
        <div class="mx-auto max-w-3xl px-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-aloe-500 mb-4">Produits mentionnés dans cet article</p>
          <div class="grid sm:grid-cols-2 gap-4">
            {produitsAvecDetails.map((p: any) => (
              <div class="rounded-2xl bg-white border border-aloe-100 p-5 flex flex-col">
                <p class="text-sm font-semibold text-aloe-800 mb-1 leading-snug">{p.nom}</p>
                {p.price && <p class="text-xl font-display text-aloe-700 mb-4">{p.price.toFixed(2)} €</p>}
                <div class="mt-auto flex flex-col gap-2">
                  {p.lienCommande && (
                    <a
                      href={p.lienCommande}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="block text-center rounded-full bg-aloe-600 hover:bg-aloe-700 px-4 py-2.5 text-sm font-semibold text-cream transition-colors"
                    >
                      Commander →
                    </a>
                  )}
                  <a href={`/produits/${p.slug}/`} class="block text-center text-xs text-aloe-500 hover:text-aloe-700 transition-colors">
                    Voir la fiche →
                  </a>
                </div>
              </div>
            ))}
          </div>
          <div class="mt-4 flex items-center gap-4 text-xs text-aloe-400 justify-center">
            <span>✓ Certifié IASC</span>
            <span>✓ Livraison 24–72h</span>
            <span>✓ Satisfait ou remboursé 30j</span>
          </div>
        </div>
      </div>
    )}

    <div class="bg-sand/50 py-10">
      <div class="mx-auto max-w-3xl px-6">
        <div class="flex items-start gap-4 rounded-2xl bg-white border border-aloe-100 p-6">
          <div class="w-14 h-14 rounded-xl bg-aloe-600 flex items-center justify-center text-cream font-bold flex-shrink-0">RA</div>
          <div>
            <p class="font-semibold text-aloe-800">{author}</p>
            <p class="text-xs text-aloe-500 mb-2">Distributeur Forever Living Products</p>
            <p class="text-sm text-aloe-600 leading-relaxed">Distributeur indépendant Forever Living Products, Rafael partage son expertise des produits Aloe Vera pour vous guider vers les solutions adaptées à vos besoins.</p>
            <a href="/contact/" class="inline-block mt-3 text-sm font-semibold text-aloe-600 hover:text-aloe-800 transition-colors">Contacter Rafael →</a>
          </div>
        </div>
      </div>
    </div>
  </article>

  <Footer />
</Layout>
