---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const articles = await getCollection('blog', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, pubDate, updatedDate, author, image, imageAlt, category, produitsLies } = article.data;

const siteUrl = 'https://espritaloe.fr';
const articleUrl = `${siteUrl}/blog/${article.id}/`;

// Enrichissement produits
const allProduits = await getCollection('produits');
const produitsAvecDetails = produitsLies.map((p: any) => {
  const found = allProduits.find((prod) => prod.data.slug === p.slug);
  return {
    slug: p.slug,
    nom: p.nom,
    price: found?.data.price ?? null,
    lienCommande: found?.data.lienCommande ?? null,
  };
});

const schemaArticle = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  url: articleUrl,
  image: image ? `${siteUrl}${image}` : undefined,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    "@type": "Person",
    name: author,
    url: `${siteUrl}/a-propos/`,
  },
  publisher: { "@id": `${siteUrl}/#organization` },
  inLanguage: "fr-FR",
};

const categoryLabels: Record<string, string> = {
  'boissons-aloe-vera': 'Boissons Aloe Vera',
  'beaute': 'Beauté & Bien-être',
  'beaute-bien-etre': 'Beauté & Bien-être',
  'programmes-detox': 'Programmes Détox',
  'sport': 'Sport & Fitness',
  'sport-et-fitness': 'Sport & Fitness',
  'bien-etre': 'Bien-être',
  'nutrition': 'Nutrition',
  'guides': 'Guides',
};

const readingTime = Math.max(1, Math.ceil((article.body?.split(' ').length ?? 0) / 200));
---

<Layout
  title={`${title} | Blog Esprit Aloé`}
  description={description}
  image={image}
  canonical={articleUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} slot="head" />

  <Header />

  <article>

    <!-- ══ EN-TÊTE : fond coloré, centré, aéré ══ -->
    <header class="bg-gradient-to-b from-aloe-800 to-aloe-900 py-20">
      <div class="mx-auto max-w-2xl px-6 text-center">
        <nav class="text-xs text-aloe-400 mb-8" aria-label="Fil d'Ariane">
          <ol class="flex items-center justify-center gap-2">
            <li><a href="/" class="hover:text-aloe-200 transition-colors">Accueil</a></li>
            <li class="text-aloe-600">›</li>
            <li><a href="/blog/" class="hover:text-aloe-200 transition-colors">Blog</a></li>
            <li class="text-aloe-600">›</li>
            <li class="text-aloe-300 truncate max-w-[200px]">{title}</li>
          </ol>
        </nav>

        <span class="inline-block rounded-full bg-aloe-700 px-4 py-1.5 text-xs font-semibold text-aloe-200 uppercase tracking-widest mb-6">
          {categoryLabels[category] ?? category}
        </span>

        <h1 class="text-3xl md:text-4xl text-cream leading-tight mb-6 font-display">{title}</h1>
        <p class="text-lg text-aloe-200 leading-relaxed mb-8">{description}</p>

        <div class="flex items-center justify-center gap-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-aloe-600 flex items-center justify-center text-cream font-bold text-sm flex-shrink-0">RA</div>
            <div class="text-left">
              <p class="text-sm font-semibold text-cream">{author}</p>
              <time class="text-xs text-aloe-400" datetime={pubDate.toISOString()}>
                {pubDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
            </div>
          </div>
          <span class="text-aloe-600">·</span>
          <span class="text-xs text-aloe-400">{readingTime} min de lecture</span>
        </div>
      </div>
    </header>

    <!-- ══ IMAGE HERO — pleine largeur, impact fort ══ -->
    {image && (
      <div class="bg-aloe-900">
        <div class="mx-auto max-w-4xl">
          <img
            src={image}
            alt={imageAlt ?? title}
            width="1200"
            height="600"
            loading="eager"
            class="w-full object-cover max-h-[500px]"
          />
        </div>
      </div>
    )}

    <!-- ══ CORPS DE L'ARTICLE + SIDEBAR ══ -->
    <div class="bg-white py-16">
      <div class="mx-auto max-w-6xl px-6">
        <div class="grid lg:grid-cols-[1fr_300px] gap-16 items-start">

          <!-- Contenu texte — max-width contraint pour lisibilité -->
          <div class="min-w-0">
            <div class="prose max-w-[680px]
              prose-headings:font-display
              prose-h2:text-2xl prose-h2:text-aloe-900 prose-h2:mt-14 prose-h2:mb-5 prose-h2:pb-3 prose-h2:border-b prose-h2:border-aloe-100
              prose-h3:text-xl prose-h3:text-aloe-800 prose-h3:mt-10 prose-h3:mb-4
              prose-p:text-aloe-700 prose-p:leading-[1.9] prose-p:text-[17px] prose-p:mb-6
              prose-a:text-aloe-600 prose-a:underline prose-a:underline-offset-2 hover:prose-a:text-aloe-800
              prose-strong:text-aloe-900 prose-strong:font-semibold
              prose-ul:text-aloe-700 prose-ul:space-y-2 prose-ul:my-6
              prose-ol:text-aloe-700 prose-ol:space-y-2 prose-ol:my-6
              prose-li:leading-relaxed prose-li:text-[17px]
              prose-blockquote:border-l-4 prose-blockquote:border-aloe-300 prose-blockquote:bg-aloe-50 prose-blockquote:rounded-r-xl prose-blockquote:py-4 prose-blockquote:px-6 prose-blockquote:text-aloe-600 prose-blockquote:not-italic prose-blockquote:my-8
              prose-table:text-sm prose-table:w-full
              prose-img:rounded-2xl prose-img:shadow-md prose-img:my-8
              prose-hr:border-aloe-100 prose-hr:my-12">
              <Content />
            </div>
          </div>

          <!-- Sidebar sticky -->
          {produitsAvecDetails.length > 0 && (
            <aside class="hidden lg:block sticky top-24 self-start space-y-5">
              <div class="rounded-2xl bg-aloe-800 p-6 text-cream">
                <p class="text-[11px] font-semibold uppercase tracking-widest text-aloe-300 mb-5">Produits recommandés</p>
                <div class="space-y-5">
                  {produitsAve