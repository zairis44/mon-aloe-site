---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import CarteArticle from '../../components/CarteArticle.astro';
import { CARROUSEL, SECTIONS, verifierSections } from '../../data/blog-sections';

const articles = await getCollection('blog', ({ data }) => !data.draft);
verifierSections(articles.map((a) => a.id));
const parSlug = new Map(articles.map((a) => [a.id, a]));
const carrousel = CARROUSEL.map((slug) => parSlug.get(slug)!);
const sections = SECTIONS.map((s) => ({ ...s, liste: s.articles.map((slug) => parSlug.get(slug)!) }));
---

<Layout
  title="Blog Aloe Vera Forever Living — Conseils bien-être naturel"
  description="Guides et articles sur les produits Aloe Vera Forever Living : digestion, peau, immunité, articulations, programmes détox. Par votre distributeur certifié."
  canonical="https://espritaloe.fr/blog/"
>
  <Header />

  <section class="bg-gradient-to-br from-aloe-50 via-cream to-sand py-20">
    <div class="mx-auto max-w-6xl px-6">
      <nav class="text-xs text-aloe-500 mb-6" aria-label="Fil d'Ariane">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-aloe-700 transition-colors">Accueil</a></li>
          <li aria-hidden="true">›</li>
          <li class="text-aloe-700 font-medium" aria-current="page">Blog</li>
        </ol>
      </nav>
      <h1 class="text-5xl text-aloe-900 mb-4">Blog Aloe Vera</h1>
      <p class="text-lg text-aloe-600 max-w-2xl">
        Conseils pratiques, guides produits et dossiers thématiques sur les bienfaits
        de l'Aloe Vera Forever Living. Digestion, immunité, peau, articulations et minceur.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       ENCADRÉ — Journal C9 en cours
  ══════════════════════════════════════════════ -->
  <section class="bg-cream pt-16">
    <div class="mx-auto max-w-6xl px-6">
      <a href="/mon-journal-c9/" class="group block rounded-3xl bg-gradient-to-br from-[#2E5E3E] to-[#215B33] p-8 md:p-10 hover:opacity-95 transition-opacity mb-4">
        <div class="flex flex-col md:flex-row items-center gap-8">
          <img
            src="/images/produits/programme-c9-forever-chocolat-peche.webp"
            width="1024"
            height="940"
            alt="Coffret Programme C9 Forever Living"
            class="w-40 md:w-48 flex-shrink-0 rounded-2xl group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
          <div class="flex-1">
            <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-1.5 text-xs font-semibold text-cream uppercase tracking-widest mb-4">
              ✓ Journal complet — 9 jours
            </span>
            <h2 class="text-2xl md:text-3xl text-cream font-display leading-tight mb-3">
              J'ai fait mon 10e C9 : mes résultats et mon ressenti, jour par jour
            </h2>
            <p class="text-aloe-200 leading-relaxed">
              −2,7 kg, −15 cm cumulés, et surtout ce que personne ne raconte : les jours difficiles,
              la faim, les doutes. Mensurations réelles et données sportives à l'appui.
            </p>
          </div>
          <span class="flex-shrink-0 inline-flex items-center gap-2 rounded-full bg-cream px-6 py-3 text-sm font-semibold text-[#215B33] group-hover:bg-aloe-100 transition-colors">
            Lire le journal →
          </span>
        </div>
      </a>

      <!-- Encadré — Guide sécurité aloe vera à boire -->
      <a href="/blog/aloe-vera-a-boire-danger-contre-indications/" class="group mt-4 block rounded-3xl border border-aloe-100 bg-white p-6 md:p-8 hover:shadow-xl hover:shadow-aloe-900/10 transition-all">
        <div class="flex flex-col md:flex-row items-center gap-6 md:gap-8">
          <img
            src="/images/blog/aloe-vera-a-boire-danger.webp"
            alt="Quatre boissons Forever à l'aloe vera : Aloe Peaches, Aloe Vera Gel, Aloe Berry Nectar et Aloe Mango"
            width="400"
            height="225"
            class="w-full md:w-64 flex-shrink-0 rounded-2xl object-cover aspect-[16/9]"
            loading="lazy"
          />
          <div class="flex-1">
            <span class="inline-flex items-center rounded-full bg-aloe-100 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-aloe-700 mb-3">
              Guide à lire avant de commencer
            </span>
            <h2 class="text-xl md:text-2xl text-aloe-900 font-display leading-snug mb-2">
              Aloe vera à boire : est-ce dangereux ?
            </h2>
            <p class="text-aloe-600 leading-relaxed">
              Latex, aloïne, avis de l'ANSES, personnes à qui demander conseil avant de commencer :
              le point sans exagérer, avec les sources officielles.
            </p>
          </div>
          <span class="flex-shrink-0 inline-flex items-center gap-2 rounded-full bg-aloe-600 px-6 py-3 text-sm font-semibold text-cream group-hover:bg-aloe-700 transition-colors">
            Lire le guide →
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       CARROUSEL — articles à lire en premier (blog-sections.ts)
  ══════════════════════════════════════════════ -->
  <section class="bg-cream pt-16 pb-8" aria-labelledby="titre-carrousel">
    <div class="mx-auto max-w-6xl px-6">
      <div class="flex items-end justify-between gap-4 mb-6">
        <h2 id="titre-carrousel" class="text-3xl text-aloe-900">À lire en premier</h2>
        <div class="hidden sm:flex gap-2" data-carrousel-nav>
          <button type="button" data-dir="-1" aria-controls="carrousel-blog" aria-label="Articles précédents"
            class="h-11 w-11 rounded-full border border-aloe-200 bg-white text-aloe-700 hover:bg-aloe-50 disabled:opacity-40 disabled:cursor-default transition-colors">←</button>
          <button type="button" data-dir="1" aria-controls="carrousel-blog" aria-label="Articles suivants"
            class="h-11 w-11 rounded-full border border-aloe-200 bg-white text-aloe-700 hover:bg-aloe-50 disabled:opacity-40 disabled:cursor-default transition-colors">→</button>
        </div>
      </div>
      <ul id="carrousel-blog" role="list" tabindex="0" aria-label="Articles à lire en premier (faire défiler horizontalement)"
        class="carrousel-blog flex gap-6 overflow-x-auto snap-x snap-mandatory motion-safe:scroll-smooth pb-4 -mx-6 px-6 scroll-px-6 focus-visible:outline-2 focus-visible:outline-aloe-500 rounded-3xl">
        {carrousel.map((a) => (
          <li class="snap-start shrink-0 w-[85%] sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-3rem)/3)]">
            <CarteArticle slug={a.id} titre={a.data.title} description={a.data.description} image={a.data.image} imageAlt={a.data.imageAlt} date={a.data.pubDate} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Sommaire des sections -->
  <nav class="bg-cream pb-4" aria-label="Thèmes du blog">
    <div class="mx-auto max-w-6xl px-6">
      <ul class="flex flex-wrap gap-2" role="list">
        {sections.map((s) => (
          <li>
            <a href={`#${s.id}`} class="inline-flex rounded-full border border-aloe-200 bg-white px-4 py-2 text-sm font-medium text-aloe-700 hover:bg-aloe-50 hover:border-aloe-300 transition-colors">
              {s.court} <span class="ml-1.5 text-aloe-400">{s.liste.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- ══════════════════════════════════════════════
       SECTIONS PAR THÈME
  ══════════════════════════════════════════════ -->
  <div class="bg-cream pb-16">
    {sections.map((s) => (
      <section id={s.id} class="scroll-mt-24 pt-12" aria-labelledby={`titre-${s.id}`}>
        <div class="mx-auto max-w-6xl px-6">
          <h2 id={`titre-${s.id}`} class="text-3xl text-aloe-900 mb-2">{s.titre}</h2>
          <p class="text-aloe-600 mb-8 max-w-2xl">{s.intro}</p>
          <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8" role="list">
            {s.liste.map((a) => (
              <li>
                <CarteArticle slug={a.id} titre={a.data.title} description={a.data.description} image={a.data.image} imageAlt={a.data.imageAlt} date={a.data.pubDate} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))}
  </div>

  <style>
    .carrousel-blog { scrollbar-width: none; }
    .carrousel-blog::-webkit-scrollbar { display: none; }
  </style>

  <script>
    const liste = document.getElementById('carrousel-blog');
    const boutons = document.querySelectorAll<HTMLButtonElement>('[data-carrousel-nav] button');
    if (liste && boutons.length) {
      const maj = () => {
        const max = liste.scrollWidth - liste.clientWidth - 2;
        boutons[0].disabled = liste.scrollLeft <= 2;
        boutons[1].disabled = liste.scrollLeft >= max;
      };
      boutons.forEach((b) =>
        b.addEventListener('click', () => {
          const doux = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          liste.scrollBy({ left: Number(b.dataset.dir) * liste.clientWidth, behavior: doux ? 'smooth' : 'auto' });
        })
      );
      liste.addEventListener('scroll', maj, { passive: true });
      window.addEventListener('resize', maj);
      maj();
    }
  </script>

  <section class="bg-sand py-16">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl text-aloe-900 mb-4">Un conseil personnalisé ?</h2>
      <p class="text-aloe-600 mb-6">Votre distributeur Forever vous répond du lundi au samedi.</p>
      <a href="/contact/" class="rounded-full bg-aloe-600 px-8 py-3.5 text-sm font-semibold text-cream hover:bg-aloe-700 transition-colors">
        Nous contacter
      </a>
    </div>
  </section>

  <Footer />
</Layout>
