---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pageUrl = "https://espritaloe.fr/devenir-distributeur-forever-living-suisse/";

// ──────────────────────────────────────────────
// ÉTAPES
// ──────────────────────────────────────────────
const etapes = [
  {
    num: "01",
    titre: "On échange",
    texte:
      "Un appel découverte de 20 minutes. Tu me poses tes questions, je te montre comment l'activité fonctionne en Suisse et on vérifie ensemble que ça colle à ton projet. Sans script, sans pression.",
  },
  {
    num: "02",
    titre: "Tu testes les produits",
    texte:
      "Avant de revendre quoi que ce soit, tu utilises la gamme. C'est ta première expérience client et ton meilleur argument de vente. On commence souvent par la pulpe d'aloe vera, le produit que tes futurs clients te demanderont en premier.",
  },
  {
    num: "03",
    titre: "Tu démarres officiellement",
    texte:
      "Inscription en ligne en quelques minutes auprès de Forever Living Suisse, avec moi comme parrain. Tu reçois ton accès à la boutique Forever, tes tarifs distributeur et tes premiers outils.",
  },
  {
    num: "04",
    titre: "Tes premières ventes",
    texte:
      "Je t'accompagne à distance sur tes premiers partages et tes premières ventes : présence en ligne, conseil produit, organisation. Tu avances à ton rythme.",
  },
];

// ──────────────────────────────────────────────
// FAQ — framing prudent, vocabulaire suisse, aucun chiffre de revenu
// ──────────────────────────────────────────────
const faq = [
  {
    q: "Forever Living est-il présent en Suisse ?",
    r: "Oui. Forever Living Products dispose de sa propre structure en Suisse, avec une boutique en ligne, des tarifs en francs suisses et ses circuits de livraison locaux. Tu commandes et te fais livrer en Suisse sans passer par la France.",
  },
  {
    q: "Peux-tu vraiment me parrainer si je vis en Suisse ?",
    r: "Oui. Mon statut de distributeur Forever me permet de parrainer et d'accompagner des candidats en Suisse, exactement comme en France : appel découverte, choix des produits, premiers pas dans l'activité. L'accompagnement se fait à distance — par téléphone, visio et messagerie.",
  },
  {
    q: "Est-ce légal en Suisse ?",
    r: "La vente directe est une activité légale et reconnue en Suisse, encadrée par la Loi fédérale contre la concurrence déloyale (LCD) et surveillée par le SECO. Le secteur dispose même de son association professionnelle, la VDF (Association Suisse pour la Vente Directe). Ce qui est interdit, c'est la vente pyramidale : un système où l'on gagne en recrutant plutôt qu'en vendant de vrais produits. Forever fonctionne sur la vente de produits réels à des clients, ce qui le place dans le cadre légal de la vente directe.",
  },
  {
    q: "Dois-je acheter du stock pour démarrer ?",
    r: "Non. Tu passes commande au fur et à mesure que tes clients achètent, et Forever livre directement. Pas besoin de stocker des cartons chez toi.",
  },
  {
    q: "Faut-il recruter une équipe pour gagner de l'argent ?",
    r: "Non. Tu peux exercer uniquement en vendant les produits à tes clients et en encaissant la marge entre ton tarif distributeur et le prix public. Construire une équipe est une option, pas une obligation.",
  },
  {
    q: "Quelles démarches administratives en Suisse ?",
    r: "Les obligations dépendent de ta situation et de ton volume d'activité (inscription, fiscalité, assurances sociales). Ces règles varient d'un canton à l'autre et selon ton cas personnel, donc je ne te donnerai pas de réponse toute faite : renseigne-toi auprès des autorités compétentes de ton canton ou d'un conseiller. En revanche, je t'accompagne sur tout le reste — les produits, la vente, l'organisation.",
  },
  {
    q: "Est-ce compatible avec un emploi ?",
    r: "Oui. Beaucoup de distributeurs commencent en activité complémentaire, à côté d'un emploi ou d'études. Tu choisis ton rythme et le temps que tu y consacres.",
  },
  {
    q: "Combien ça rapporte ?",
    r: "Je ne te promettrai aucun montant : ce serait malhonnête. Tes résultats dépendent de ton implication, de ta régularité et de ta clientèle. Ce que je peux te garantir, c'est un accompagnement clair et des produits que les gens rachètent. Le reste se construit.",
  },
];

const schemaFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, r }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: r },
  })),
};

const schemaWebPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": pageUrl,
  url: pageUrl,
  name: "Devenir Distributeur Forever Living en Suisse",
  description:
    "Comment devenir distributeur (revendeur) Forever Living en Suisse : fonctionnement, étapes, cadre légal et accompagnement par Rafael Avenard.",
  inLanguage: "fr-CH",
  about: {
    "@type": "Occupation",
    name: "Distributeur Forever Living Products",
    description:
      "Activité indépendante de vente directe de produits aloe vera en Suisse.",
  },
  author: {
    "@type": "Person",
    name: "Rafael Avenard",
    jobTitle: "Distributeur Indépendant Forever Living Products",
    telephone: "+33677352226",
  },
};
---

<Layout
  title="Devenir Distributeur Forever Living en Suisse | Esprit Aloé"
  description="Comment devenir distributeur (revendeur) Forever Living en Suisse ? Fonctionnement, étapes, cadre légal. Parrainage et accompagnement à distance par Rafael."
  canonical={pageUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(schemaWebPage)} slot="head" />

  <Header />

  <!-- ══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <section class="bg-aloe-900 py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <span class="inline-block rounded-full bg-aloe-700 px-4 py-1.5 text-xs font-semibold text-aloe-200 uppercase tracking-widest mb-6">
            Opportunité business — Suisse
          </span>
          <h1 class="text-4xl md:text-5xl text-cream font-display leading-tight mb-6">
            Devenir distributeur Forever Living en Suisse —<br />
            <span class="text-aloe-400 italic">comment ça marche</span>
          </h1>
          <p class="text-lg text-aloe-200 leading-relaxed mb-8">
            Lancer une activité de vente directe autour de produits aloe vera que tes clients consomment chaque jour, sans stock obligatoire ni quota, à ton rythme. Forever Living est présent en Suisse, et je peux te parrainer et t'accompagner à distance pour démarrer.
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <a href="tel:+33677352226"
              class="rounded-full bg-aloe-500 hover:bg-aloe-400 px-8 py-4 text-sm font-semibold text-cream transition-colors">
              📞 En parler — 06 77 35 22 26
            </a>
            <a href="#etapes"
              class="rounded-full border border-aloe-500 hover:border-aloe-300 px-8 py-4 text-sm font-semibold text-aloe-200 hover:text-cream transition-colors">
              Voir les étapes ↓
            </a>
          </div>
        </div>
        <div class="hidden md:block">
          <!-- Emplacement image : à choisir par Rafael (idéalement aloe vera + ambiance suisse/montagne) -->
          <div class="aspect-[4/5] rounded-3xl bg-aloe-800 border border-aloe-700"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       INTRO — répond à l'intention de recherche
  ══════════════════════════════════════════ -->
  <section class="bg-cream py-20">
    <div class="mx-auto max-w-3xl px-6">
      <p class="text-lg text-aloe-800 leading-relaxed mb-6">
        Tu cherches à devenir distributeur — ou revendeur — Forever Living en Suisse, et tu te demandes si c'est faisable, légal et sérieux. Réponse courte : oui aux trois. Forever Living Products opère en Suisse avec sa propre boutique, ses tarifs en francs et sa logistique locale. L'activité relève de la vente directe, un modèle légal et encadré.
      </p>
      <p class="text-lg text-aloe-800 leading-relaxed">
        Cette page t'explique comment ça fonctionne concrètement, ce que tu peux attendre, le cadre légal suisse et la façon dont je t'accompagne à distance pour démarrer.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       CE QUE C'EST VRAIMENT
  ══════════════════════════════════════════ -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-3xl text-aloe-900 mb-8 font-display">Distributeur Forever en Suisse : ce que ça veut dire</h2>
      <p class="text-aloe-700 leading-relaxed mb-6">
        Devenir distributeur Forever, c'est t'inscrire auprès de Forever Living avec un parrain, acheter les produits à ton tarif distributeur et les revendre à tes clients. Tu encaisses la marge entre ton prix et le prix public. Tu n'es pas salarié de Forever : tu gères ta propre activité, tes horaires et tes canaux de vente. Forever fournit les produits, la livraison, la plateforme de commande et la formation.
      </p>
      <p class="text-aloe-700 leading-relaxed mb-6">
        Sur ce site, j'emploie indifféremment les mots distributeur, revendeur et FBO (Forever Business Owner) : c'est la même chose. Si tu veux creuser ce que recouvre le statut, je l'explique en détail dans mon article sur le <a href="/blog/fbo-forever-living-comment-ca-marche/" class="text-aloe-600 underline hover:text-aloe-800">statut FBO Forever Living</a>.
      </p>
      <p class="text-aloe-700 leading-relaxed">
        Et non, ce n'est pas une franchise : pas de droit d'entrée à plusieurs dizaines de milliers de francs, pas de local imposé, pas de contrat contraignant. Si la distinction t'intéresse, je la détaille dans <a href="/blog/forever-living-franchise-ou-vente-directe/" class="text-aloe-600 underline hover:text-aloe-800">franchise ou vente directe</a>.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       ÉTAPES
  ══════════════════════════════════════════ -->
  <section id="etapes" class="bg-aloe-50 py-20">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="text-3xl text-aloe-900 mb-12 font-display text-center">Comment démarrer, étape par étape</h2>
      <div class="grid md:grid-cols-2 gap-8">
        {etapes.map((e) => (
          <div class="rounded-2xl bg-white border border-aloe-100 p-8">
            <span class="text-4xl font-display text-aloe-300">{e.num}</span>
            <h3 class="text-xl font-semibold text-aloe-800 mt-3 mb-3">{e.titre}</h3>
            <p class="text-aloe-600 leading-relaxed">{e.texte}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       CADRE LÉGAL SUISSE — E-E-A-T
  ══════════════════════════════════════════ -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="text-3xl text-aloe-900 mb-8 font-display">Est-ce légal et sérieux en Suisse ?</h2>
      <p class="text-aloe-700 leading-relaxed mb-6">
        La vente directe est légale et reconnue en Suisse. Elle est encadrée par la Loi fédérale contre la concurrence déloyale (LCD), surveillée par le SECO, et le secteur dispose de sa propre association professionnelle, la VDF (Association Suisse pour la Vente Directe).
      </p>
      <p class="text-aloe-700 leading-relaxed mb-6">
        La ligne rouge, c'est la vente pyramidale : un système où l'on est rémunéré principalement pour recruter de nouvelles personnes, et non pour vendre de vrais produits. C'est interdit. Forever Living fonctionne à l'inverse : la rémunération vient de la vente de produits réels à des clients. C'est ce qui place l'activité dans le cadre légal de la vente directe.
      </p>
      <p class="text-aloe-700 leading-relaxed">
        Côté démarches — inscription, fiscalité, assurances sociales — les règles dépendent de ton canton et de ta situation. Je ne te donnerai pas de chiffres tout faits là-dessus : le plus sûr est de te renseigner auprès des autorités compétentes de ton canton ou d'un conseiller. Pour tout le reste — produits, vente, organisation — je suis là.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       FAQ
  ══════════════════════════════════════════ -->
  <section class="bg-aloe-50 py-20">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="text-3xl text-aloe-900 mb-12 font-display text-center">Questions fréquentes</h2>
      <div class="space-y-4">
        {faq.map(({ q, r }) => (
          <details class="group rounded-2xl bg-white border border-aloe-100 p-6">
            <summary class="flex cursor-pointer items-center justify-between font-semibold text-aloe-800 list-none">
              {q}
              <span class="text-aloe-400 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-aloe-600 leading-relaxed">{r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       MAILLAGE INTERNE
  ══════════════════════════════════════════ -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="text-2xl text-aloe-900 mb-8 font-display text-center">Pour aller plus loin</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <a href="/devenir-distributeur-forever-living/" class="block rounded-2xl border border-aloe-100 bg-cream/60 p-6 hover:border-aloe-300 hover:shadow-md transition-all">
          <span class="text-2xl block mb-3">🌿</span>
          <h3 class="font-semibold text-aloe-800 mb-2 leading-snug">Devenir distributeur (France)</h3>
          <p class="text-sm text-aloe-600 leading-relaxed">Le guide complet : étapes, fonctionnement et accompagnement.</p>
          <span class="text-xs font-semibold text-aloe-500 mt-3 inline-block">Voir la page →</span>
        </a>
        <a href="/blog/fbo-forever-living-comment-ca-marche/" class="block rounded-2xl border border-aloe-100 bg-cream/60 p-6 hover:border-aloe-300 hover:shadow-md transition-all">
          <span class="text-2xl block mb-3">📋</span>
          <h3 class="font-semibold text-aloe-800 mb-2 leading-snug">FBO Forever : qu'est-ce que c'est ?</h3>
          <p class="text-sm text-aloe-600 leading-relaxed">Définition, différence avec un client, niveaux et inscription.</p>
          <span class="text-xs font-semibold text-aloe-500 mt-3 inline-block">Lire l'article →</span>
        </a>
        <a href="/blog/forever-living-franchise-ou-vente-directe/" class="block rounded-2xl border border-aloe-100 bg-cream/60 p-6 hover:border-aloe-300 hover:shadow-md transition-all">
          <span class="text-2xl block mb-3">⚖️</span>
          <h3 class="font-semibold text-aloe-800 mb-2 leading-snug">Franchise ou vente directe ?</h3>
          <p class="text-sm text-aloe-600 leading-relaxed">Pourquoi Forever n'est pas une franchise. Le comparatif.</p>
          <span class="text-xs font-semibold text-aloe-500 mt-3 inline-block">Lire l'article →</span>
        </a>
        <a href="/blog/forever-living-avis-produits-france/" class="block rounded-2xl border border-aloe-100 bg-cream/60 p-6 hover:border-aloe-300 hover:shadow-md transition-all">
          <span class="text-2xl block mb-3">⭐</span>
          <h3 class="font-semibold text-aloe-800 mb-2 leading-snug">Les produits valent-ils le coup ?</h3>
          <p class="text-sm text-aloe-600 leading-relaxed">Retours clients, certifications et points d'attention avant de te lancer.</p>
          <span class="text-xs font-semibold text-aloe-500 mt-3 inline-block">Lire les avis →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       CTA FINAL
  ══════════════════════════════════════════ -->
  <section class="bg-aloe-800 py-20">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl text-cream mb-4">Une question sur l'activité en Suisse ?</h2>
      <p class="text-aloe-200 leading-relaxed mb-8 text-lg">
        Un appel de 20 minutes suffit pour répondre à tes questions et voir si l'activité Forever correspond à ton projet. Sans script, sans pression.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="tel:+33677352226"
          class="rounded-full bg-aloe-500 hover:bg-aloe-400 px-10 py-4 text-sm font-semibold text-cream transition-colors">
          📞 Appeler — 06 77 35 22 26
        </a>
        <a href="/contact/"
          class="rounded-full border border-aloe-500 hover:border-aloe-300 px-10 py-4 text-sm font-semibold text-aloe-200 hover:text-cream transition-colors">
          ✉️ Envoyer un message
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
