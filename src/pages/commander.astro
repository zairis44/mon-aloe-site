---
/**
 * src/pages/commander.astro
 * Page « Acheter et commander Forever Living en France » — Esprit Aloé
 * Objectif : convertir les visiteurs en acheteurs, réduire la friction.
 * SEO (lot AM, 20/11/2026) : intention transactionnelle du groupe « Acheter Forever en France »
 *   « forever commande en ligne », « boutique forever (living) », « acheter produits forever ».
 *   L'accueil garde « forever living france / distributeur » (page en mesure jusqu'au 9/12).
 * Schema.org : BreadcrumbList + HowTo + FAQPage
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { PRODUITS_RECOMMANDES } from '../data/recommandes';
import { OFFRE_BIENVENUE } from '../data/offres';
import { foreverHref, FOREVER_REL } from '../lib/forever';

const siteUrl = "https://espritaloe.fr";
const boutiqueUrl = "https://www.foreverliving.fr/ref/330001628607/";

const essentiel = [
  { titre: "Où acheter ?", texte: "Sur la boutique en ligne officielle Forever Living. Forever ne vend pas ses produits en magasin." },
  { titre: "Avec qui ?", texte: "Chaque client est rattaché à un distributeur. Avec mon lien, c'est moi qui vous accompagne." },
  { titre: "Première commande", texte: `Code ${OFFRE_BIENVENUE.code} : −${OFFRE_BIENVENUE.remise} dès ${OFFRE_BIENVENUE.minimum}, à la création de votre compte.` },
  { titre: "Livraison", texte: "Point relais en 48 à 72 h, offerte dès 50 € d'achat, ou Chronopost à domicile en J+1." },
];

// Pas-à-pas illustré : captures de la boutique Forever fournies par Rafael le 21/11/2026
// (données personnelles floutées), dans public/images/commander/.
const etapes = [
  {
    numero: "01",
    titre: "Choisissez votre produit et cliquez sur « Commander sur Forever »",
    texte:
      "Sur chaque fiche produit d'Esprit Aloé, le bouton « Commander sur Forever » ouvre ce produit sur la boutique officielle Forever Living France, déjà rattaché à moi comme distributeur.",
    image: "/images/commander/etape-1-fiche.webp", w: 619, h: 500,
    alt: "Fiche produit Esprit Aloé : prix et bouton « Commander sur Forever »",
    lien: "/produits/",
    labelLien: "Voir les produits",
  },
  {
    numero: "02",
    titre: "Ajoutez le produit au panier",
    texte:
      "Sur la boutique Forever, choisissez la quantité puis cliquez sur « Ajouter au panier ». Un message confirme l'ajout : ouvrez ensuite votre panier avec l'icône en haut à droite.",
    image: "/images/commander/etape-2-panier.webp", w: 1000, h: 859,
    alt: "Page produit de la boutique Forever : quantité, bouton « Ajouter au panier » et confirmation",
    lien: null,
    labelLien: null,
  },
  {
    numero: "03",
    titre: "Continuez vos achats ou passez à l'étape suivante",
    texte:
      "Le panier affiche le total et les conditions de livraison. Ajoutez d'autres produits avec « Continuer mes achats », ou cliquez sur « Passer à l'étape suivante ».",
    image: "/images/commander/etape-3-etape-suivante.webp", w: 1000, h: 326,
    alt: "Panier de la boutique Forever avec le total et le bouton « Passer à l'étape suivante »",
    lien: null,
    labelLien: null,
  },
  {
    numero: "04",
    titre: "Créez votre compte client",
    texte:
      "Première commande : remplissez « Je crée mon compte client » (civilité, prénom, nom, e-mail, mot de passe, adresse). Déjà client : connectez-vous à gauche avec votre e-mail.",
    image: "/images/commander/etape-4-compte.webp", w: 1000, h: 935,
    alt: "Formulaire « Je crée mon compte client » de la boutique Forever",
    lien: null,
    labelLien: null,
  },
  {
    numero: "05",
    titre: "Vérifiez mon numéro de conseiller et validez",
    texte:
      "Complétez le pays, le code postal, la ville et le téléphone, acceptez les CGU et les CGV. Dans « Connaissez-vous un conseiller Forever ? », mon numéro 330001628607 doit apparaître : saisissez-le s'il est vide. Cliquez sur « Créer mon compte ».",
    image: "/images/commander/etape-5-conseiller.webp", w: 900, h: 1016,
    alt: "Suite du formulaire Forever : conseiller Forever 330001628607 et bouton « Créer mon compte »",
    lien: null,
    labelLien: null,
  },
  {
    numero: "06",
    titre: "Choisissez la livraison et saisissez votre code promo",
    texte:
      `Point relais ou domicile : le prix s'affiche à côté de chaque mode. Nouveau client avec un panier d'au moins ${OFFRE_BIENVENUE.minimum} : saisissez ${OFFRE_BIENVENUE.code} dans « Code promo » puis cliquez sur « Valider ».`,
    image: "/images/commander/etape-6-livraison.webp", w: 1000, h: 276,
    alt: "Choix du mode de livraison (domicile ou point relais) et champ code promo sur la boutique Forever",
    lien: "/livraison/",
    labelLien: "Tarifs de livraison",
  },
  {
    numero: "07",
    titre: "Payez par carte bancaire",
    texte:
      "Le paiement se fait sur la plateforme sécurisée Systempay de la Banque Populaire : CB, Visa, Visa Electron, Mastercard, Maestro ou e-Carte Bleue. Vérifiez le récapitulatif (produits, frais de port, total) avant de payer.",
    image: "/images/commander/etape-7-paiement.webp", w: 1000, h: 282,
    alt: "Page de paiement sécurisé de la boutique Forever avec le récapitulatif du panier",
    lien: null,
    labelLien: null,
  },
];

const modesCommande = [
  {
    icon: "🖥️",
    titre: "Boutique officielle Forever",
    description:
      "Commandez sur le site officiel Forever Living grâce à mon lien distributeur. Vous quittez Esprit Aloé pour choisir vos produits et finaliser votre achat sur Forever.",
    avantages: [
      "Accès direct à la boutique officielle",
      "Catalogue et prix affichés par Forever",
      "Commande en ligne 7j/7",
    ],
    cta: "Ouvrir la boutique Forever France",
    ctaUrl: boutiqueUrl,
    badge: "Recommandé",
  },
  {
    icon: "📞",
    titre: "Par téléphone",
    description:
      "Vous hésitez entre plusieurs produits ? Appelez-moi pour en parler avant de commander et préparer votre achat ensemble.",
    avantages: [
      "Conseils personnalisés avant achat",
      "Du lundi au samedi, aux horaires de conseil",
      "Aide pour votre première commande",
    ],
    cta: "06 77 35 22 26",
    ctaUrl: "tel:+33677352226",
    badge: null,
  },
  {
    icon: "✉️",
    titre: "Par e-mail",
    description:
      "Envoyez-moi les noms des produits qui vous intéressent. Je vous réponds avec les informations utiles pour préparer votre commande.",
    avantages: [
      "Échange écrit pour préparer votre achat",
      "Pratique pour les commandes récurrentes",
      "Possibilité de joindre une liste de produits",
    ],
    cta: "contact@espritaloe.fr",
    ctaUrl: "mailto:contact@espritaloe.fr",
    badge: null,
  },
];

const tarifsRelais = [
  { montant: "Moins de 50 € d'achat", frais: "3,90 €" },
  { montant: "À partir de 50 € d'achat", frais: "Offerte" },
];

const tousProduits = await getCollection('produits');
const recommandes = PRODUITS_RECOMMANDES.map(({ slug, note }) => {
  const p = tousProduits.find((x) => x.data.slug === slug);
  if (!p) throw new Error(`Produit recommandé introuvable : ${slug}`);
  return {
    slug,
    note,
    nom: p.data.name,
    nomCourt: p.data.name.split(/ – | : | \| /)[0],
    image: p.data.image || null,
    prix: `${p.data.price.toFixed(2).replace('.', ',')} €`,
    lien: foreverHref(p.data.lienCommande) ?? '/contact/',
  };
});

const faq = [
  {
    q: "Où acheter les produits Forever Living en France ?",
    r: "Sur la boutique en ligne officielle Forever Living France. Forever ne vend pas ses produits en magasin : vous commandez en ligne, rattaché à un distributeur indépendant qui vous conseille. Avec le lien de cette page, ce distributeur, c'est moi.",
  },
  {
    q: "Peut-on commander Forever sans distributeur ?",
    r: "Non. Sur le site officiel, chaque client est rattaché à un distributeur. Si vous arrivez sans lien, Forever vous oriente vers un distributeur. Passer par mon lien vous évite cette étape et vous donne un contact direct pour vos questions.",
  },
  {
    q: "Dois-je créer un compte pour commander en ligne ?",
    r: "Oui. Après avoir rempli votre panier, la boutique Forever vous demande de créer votre compte client (ou de vous connecter si vous êtes déjà client). Vérifiez que mon numéro de conseiller, 330001628607, est bien indiqué. En cas de blocage, appelez-moi au 06 77 35 22 26.",
  },
  {
    q: "Quels moyens de paiement accepte la boutique Forever ?",
    r: "La carte bancaire : CB, Visa, Visa Electron, Mastercard, Maestro et e-Carte Bleue, sur la plateforme de paiement sécurisé Systempay de la Banque Populaire.",
  },
  {
    q: "Y a-t-il un code promo pour une première commande Forever ?",
    r: `Oui : le code ${OFFRE_BIENVENUE.code} donne −${OFFRE_BIENVENUE.remise} aux nouveaux clients dès ${OFFRE_BIENVENUE.minimum} d'achat, sur la commande passée à l'inscription. Il n'est pas cumulable avec une autre offre.`,
  },
  {
    q: "Combien coûte la livraison des produits Forever ?",
    r: "En point relais : 3,90 € sous 50 € d'achat, offerte dès 50 €, en 48 à 72 h pour une commande passée avant 12 h 45. À domicile avec Chronopost : 13 €, livraison le lendemain pour une commande passée avant 12 h 45, pas de livraison le samedi.",
  },
  {
    q: "Les prix sont-ils les mêmes que sur le site officiel Forever ?",
    r: "Oui, puisque vous commandez sur la boutique officielle : les prix et le total sont ceux affichés par Forever. Le distributeur n'ajoute aucun frais.",
  },
  {
    q: "Peut-on acheter Forever sur Amazon ou en pharmacie ?",
    r: "Forever ne vend pas en pharmacie ni en magasin. Sur Amazon ou d'autres places de marché, vous achetez à un revendeur tiers, pas à Forever : vérifiez qui vend, l'état de l'emballage et la date limite. Sur la boutique officielle, vous recevez les produits directement de Forever.",
  },
  {
    q: "Comment commander depuis la Belgique, la Suisse ou les DOM-TOM ?",
    r: "Forever gère des boutiques par pays, avec leurs propres prix et frais de livraison. Contactez-moi avant de commander : je vous indique comment commander depuis chez vous.",
  },
  {
    q: "Et si je ne suis pas satisfait(e) ?",
    r: "Consultez les conditions de retour de Forever Living applicables à votre commande. Je peux vous aider à trouver les informations et à faire votre demande.",
  },
];

// ── Schema.org BreadcrumbList ─────────────────────────────────────────────
const schemaBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "Commander", item: `${siteUrl}/commander/` },
  ],
};

// ── Schema.org HowTo ──────────────────────────────────────────────────────
const schemaHowTo = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "Comment commander des produits Forever Living en ligne en France",
  description:
    "Les 7 étapes pour acheter des produits Forever Living sur la boutique officielle en France, du choix du produit au paiement.",
  step: etapes.map((e, i) => ({
    "@type": "HowToStep",
    position: i + 1,
    name: e.titre,
    text: e.texte,
    image: `${siteUrl}${e.image}`,
  })),
};

// ── Schema.org FAQPage ────────────────────────────────────────────────────
const schemaFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, r }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: r },
  })),
};
---

<Layout
  title="Commander Forever en ligne : boutique Forever Living France"
  description={`Acheter Forever Living en France : la boutique officielle étape par étape, le code ${OFFRE_BIENVENUE.code} (−${OFFRE_BIENVENUE.remise} sur la 1re commande) et les frais de livraison.`}
  canonical="https://espritaloe.fr/commander/"
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(schemaHowTo)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} slot="head" />

  <Header />

  <!-- ══════════════════════════════════════════
       EN-TÊTE
  ══════════════════════════════════════════ -->
  <section class="bg-gradient-to-br from-aloe-50 via-cream to-sand py-16">
    <div class="mx-auto max-w-6xl px-6">
      <nav class="text-xs text-aloe-400 mb-6" aria-label="Fil d'Ariane">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-aloe-600 transition-colors">Accueil</a></li>
          <li>›</li>
          <li class="text-aloe-700 font-medium">Commander</li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-block rounded-full bg-aloe-100 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-aloe-700 mb-6">
          Boutique Forever Living — France
        </span>
        <h1 class="text-4xl md:text-5xl text-aloe-900 leading-tight mb-6">
          Acheter et commander les produits
          <span class="italic text-aloe-500">Forever Living en France</span>
        </h1>
        <p class="text-xl text-aloe-700 leading-relaxed max-w-2xl mb-8">
          Les produits Forever s'achètent en ligne, sur la boutique officielle Forever Living France.
          Je suis <a href="/a-propos/" class="underline underline-offset-4 hover:text-aloe-900">Rafael Avenard, distributeur indépendant Forever depuis 2016</a> :
          voici comment passer commande en quelques minutes, et comment je vous accompagne.
        </p>
        <a
          href={boutiqueUrl}
          target="_blank"
          rel="sponsored noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-aloe-600 px-8 py-4 text-sm font-semibold text-cream hover:bg-aloe-700 transition-colors"
        >
          🛒 Ouvrir la boutique Forever France
        </a>
        <p class="mt-3 text-sm text-aloe-600">
          Vous poursuivrez votre commande sur le site officiel Forever Living dans un nouvel onglet.
        </p>
      </div>

      <!-- L'essentiel en 30 secondes -->
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {essentiel.map((e) => (
          <div class="rounded-2xl bg-white/80 border border-aloe-100 p-5">
            <p class="text-xs font-semibold uppercase tracking-widest text-aloe-500 mb-2">{e.titre}</p>
            <p class="text-sm text-aloe-700 leading-relaxed">{e.texte}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       ÉTAPES (HowTo)
  ══════════════════════════════════════════ -->
  <section class="bg-cream py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-14">
        <span class="text-xs font-semibold uppercase tracking-widest text-aloe-500">Pas à pas</span>
        <h2 class="text-4xl text-aloe-900 mt-2">Commander Forever en ligne : les étapes en images</h2>
      </div>
      <ol class="space-y-8">
        {etapes.map((e) => (
          <li class="rounded-2xl bg-white border border-aloe-100 p-6 md:p-8 grid md:grid-cols-5 gap-6 items-center">
            <div class="md:col-span-2">
              <span class="text-xs font-semibold text-aloe-400 tracking-widest">Étape {e.numero}</span>
              <h3 class="text-xl font-semibold text-aloe-800 mt-2 mb-3 leading-snug">{e.titre}</h3>
              <p class="text-sm text-aloe-600 leading-relaxed">{e.texte}</p>
              {e.lien && (
                <a
                  href={e.lien}
                  class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-aloe-600 hover:text-aloe-800 transition-colors"
                >
                  {e.labelLien} →
                </a>
              )}
            </div>
            <div class="md:col-span-3">
              <img
                src={e.image}
                alt={e.alt}
                width={e.w}
                height={e.h}
                loading="lazy"
                decoding="async"
                class="w-full h-auto rounded-xl border border-aloe-100 shadow-sm"
              />
            </div>
          </li>
        ))}
      </ol>
      <div class="text-center mt-10">
        <a
          href={boutiqueUrl}
          target="_blank"
          rel="sponsored noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-aloe-600 px-8 py-4 text-sm font-semibold text-cream hover:bg-aloe-700 transition-colors"
        >
          Commencer ma commande
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       RECOMMANDER EN 1 CLIC (Lot V4)
  ══════════════════════════════════════════ -->
  <section class="bg-sand/50 py-16" aria-labelledby="titre-recommandes">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-10">
        <span class="text-xs font-semibold uppercase tracking-widest text-aloe-500">Déjà client ?</span>
        <h2 id="titre-recommandes" class="text-3xl md:text-4xl text-aloe-900 mt-2">Recommander en 1 clic</h2>
        <p class="text-aloe-600 mt-3 max-w-2xl">Les produits que je recommande le plus souvent. Le bouton ouvre directement le produit sur la boutique Forever.</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        {recommandes.map((r) => (
          <div class="flex flex-col rounded-2xl bg-white border border-aloe-100 p-5">
            <a href={`/produits/${r.slug}/`} class="block aspect-square mb-4">
              {r.image ? (
                <img src={r.image} alt={r.nom} width="300" height="300" loading="lazy" class="w-full h-full object-contain" />
              ) : (
                <span class="flex w-full h-full items-center justify-center text-5xl">🌿</span>
              )}
            </a>
            <h3 class="text-base text-aloe-800 leading-snug mb-1">{r.nomCourt}</h3>
            <p class="text-xs text-aloe-500 mb-3 flex-1">{r.note}</p>
            <p class="font-display text-lg text-aloe-900 mb-3">{r.prix}</p>
            <a href={r.lien} target="_blank" rel={FOREVER_REL} class="inline-flex justify-center rounded-full bg-aloe-600 px-4 py-2.5 text-sm font-semibold text-cream hover:bg-aloe-700 transition-colors">Commander</a>
            <a href={`/produits/${r.slug}/`} class="mt-2 text-center text-xs font-semibold text-aloe-600 hover:text-aloe-800">Voir la fiche</a>
          </div>
        ))}
      </div>
      <p class="mt-8 text-sm text-aloe-600">
        Vous cherchez un autre produit ? Parcourez la
        <a href="/catalogue-forever/" class="underline underline-offset-4 hover:text-aloe-900">liste des produits Forever avec leurs prix</a>
        ou laissez-vous guider : <a href="/quel-produit-forever-choisir/" class="underline underline-offset-4 hover:text-aloe-900">quel produit Forever choisir</a>.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       3 MODES DE COMMANDE
  ══════════════════════════════════════════ -->
  <section class="bg-cream py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-14">
        <span class="text-xs font-semibold uppercase tracking-widest text-aloe-500">Choisissez votre façon</span>
        <h2 class="text-4xl text-aloe-900 mt-2">Trois façons de commander</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {modesCommande.map((m) => (
          <div class="rounded-2xl bg-white border border-aloe-100 p-8 flex flex-col relative">
            {m.badge && (
              <span class="absolute -top-3 left-8 rounded-full bg-aloe-600 px-4 py-1 text-xs font-semibold text-cream">
                {m.badge}
              </span>
            )}
            <span class="text-3xl mb-4">{m.icon}</span>
            <h3 class="text-xl font-semibold text-aloe-800 mb-3">{m.titre}</h3>
            <p class="text-sm text-aloe-600 leading-relaxed mb-5">{m.description}</p>
            <ul class="space-y-2 mb-8 flex-1">
              {m.avantages.map((av) => (
                <li class="flex items-start gap-2 text-sm text-aloe-700">
                  <span class="text-aloe-500 mt-0.5">✓</span>
                  <span>{av}</span>
                </li>
              ))}
            </ul>
            <a
              href={m.ctaUrl}
              target={m.ctaUrl.startsWith("http") ? "_blank" : undefined}
              rel={m.ctaUrl.startsWith("http") ? "sponsored noopener noreferrer" : undefined}
              class="inline-flex items-center justify-center gap-2 rounded-full bg-aloe-600 px-6 py-3 text-sm font-semibold text-cream hover:bg-aloe-700 transition-colors text-center"
            >
              {m.cta}
            </a>
            {m.ctaUrl.startsWith("http") && (
              <p class="mt-3 text-xs text-aloe-600 text-center">Site officiel Forever Living · Nouvel onglet</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       LIVRAISON (tarifs canoniques, voir /livraison/)
  ══════════════════════════════════════════ -->
  <section class="bg-aloe-800 text-cream py-16">
    <div class="mx-auto max-w-4xl px-6">
      <div class="text-center mb-10">
        <h2 class="text-3xl text-cream">Combien coûte la livraison ?</h2>
        <p class="text-aloe-200 mt-2 text-sm">Conditions affichées par Forever pour la France métropolitaine. Les frais s'affichent sur la boutique avant le paiement.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="rounded-2xl bg-aloe-700/50 p-6">
          <p class="font-semibold text-cream mb-1">📦 Point relais</p>
          <p class="text-xs text-aloe-200 mb-4">48 à 72 h pour une commande passée avant 12 h 45, retrait sous 7 jours.</p>
          <table class="w-full text-sm">
            <tbody class="divide-y divide-aloe-600">
              {tarifsRelais.map((t) => (
                <tr>
                  <td class="py-2 text-aloe-100">{t.montant}</td>
                  <td class="py-2 text-right font-semibold text-cream">{t.frais}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="rounded-2xl bg-aloe-700/50 p-6">
