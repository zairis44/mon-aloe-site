---
/**
 * src/pages/commander.astro
 * Page "Comment commander" — Esprit Aloé
 * Objectif : convertir les visiteurs en acheteurs, réduire la friction
 * SEO : longue traîne "commander produits forever living france"
 * Schema.org : HowTo + FAQPage
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const boutiqueUrl = "https://www.foreverliving.fr/ref/330001628607/";

const etapes = [
  {
    numero: "01",
    titre: "Parcourez les produits",
    texte:
      "Vous connaissez déjà votre produit ? Retrouvez-le dans la boutique Forever. Pour choisir, consultez nos fiches produit ou contactez Rafael au 06 77 35 22 26.",
    icon: "🌿",
    lien: "/produits/",
    labelLien: "Voir les produits",
  },
  {
    numero: "02",
    titre: "Choisissez votre mode de commande",
    texte:
      "Ouvrez la boutique officielle Forever Living pour commander en ligne. Si vous préférez un accompagnement, contactez Rafael par téléphone ou par e-mail pour préparer votre commande.",
    icon: "🛒",
    lien: null,
    labelLien: null,
  },
  {
    numero: "03",
    titre: "Validez et payez en sécurité",
    texte:
      "Suivez les instructions de la boutique Forever pour votre compte, la livraison et le règlement. Vérifiez les produits, les frais et le total avant de valider. Pour une commande accompagnée, Rafael vous explique les modalités.",
    icon: "🔒",
    lien: null,
    labelLien: null,
  },
  {
    numero: "04",
    titre: "Recevez votre commande",
    texte:
      "Consultez les options et les délais de livraison proposés pour votre adresse lors de la commande. Pour une question après votre achat, contactez Rafael avec votre référence de commande.",
    icon: "📦",
    lien: "/livraison/",
    labelLien: "Détails livraison",
  },
];

const modesCommande = [
  {
    icon: "🖥️",
    titre: "Boutique officielle Forever",
    description:
      "Commandez sur le site officiel Forever Living grâce au lien distributeur de Rafael. Vous quitterez Esprit Aloé pour choisir vos produits et finaliser votre achat sur Forever.",
    avantages: [
      "Accès direct à la boutique officielle",
      "Catalogue et prix affichés par Forever",
      "Modalités de livraison et de paiement dans la boutique",
    ],
    cta: "Ouvrir la boutique Forever France",
    ctaUrl: boutiqueUrl,
    badge: "Recommandé",
  },
  {
    icon: "📞",
    titre: "Par téléphone",
    description:
      "Vous hésitez entre plusieurs produits ? Appelez Rafael pour en parler avant de commander et préparer votre achat avec lui.",
    avantages: [
      "Conseils personnalisés avant achat",
      "Idéal si vous hésitez entre plusieurs produits",
      "Aide pour préparer votre commande",
    ],
    cta: "06 77 35 22 26",
    ctaUrl: "tel:+33677352226",
    badge: null,
  },
  {
    icon: "✉️",
    titre: "Par e-mail",
    description:
      "Envoyez les noms des produits qui vous intéressent. Rafael vous répondra avec les informations nécessaires pour préparer votre commande.",
    avantages: [
      "Échange écrit pour préparer votre achat",
      "Pratique pour les commandes récurrentes",
      "Possibilité de joindre une liste de produits",
    ],
    cta: "contact@espritaloe.fr",
    ctaUrl: "mailto:contact@espritaloe.fr",
    badge: null,
  },
];

const faq = [
  {
    q: "Dois-je créer un compte pour commander ?",
    r: "Pour un achat en ligne, suivez les instructions de connexion ou d'inscription affichées par la boutique Forever Living. Si vous avez besoin d'aide, contactez Rafael par téléphone ou par e-mail avant de poursuivre.",
  },
  {
    q: "Les prix sont-ils les mêmes que sur la boutique officielle Forever ?",
    r: "Le lien distributeur ouvre la boutique officielle Forever Living. Vous y consultez les prix des produits et le total de votre commande avant de valider votre achat. Rafael peut vous accompagner dans votre choix.",
  },
  {
    q: "Puis-je bénéficier d'une réduction client privilégié ?",
    r: "Consultez les conditions des offres affichées dans la boutique Forever au moment de votre achat. Rafael peut vous aider à comprendre les modalités du statut client privilégié.",
  },
  {
    q: "Comment savoir quel produit me convient ?",
    r: "Appelez Rafael au 06 77 35 22 26 pour un conseil personnalisé ou consultez les fiches produit du site pour comparer les usages et les caractéristiques.",
  },
  {
    q: "Livrez-vous dans les DOM-TOM ?",
    r: "Pour une adresse en outre-mer, vérifiez les destinations et les modalités proposées par la boutique Forever Living. Contactez Rafael si vous avez besoin d'aide avant de commander.",
  },
  {
    q: "Et si je ne suis pas satisfait(e) ?",
    r: "Consultez les conditions de retour de Forever Living applicables à votre commande. Rafael peut vous aider à trouver les informations nécessaires pour effectuer votre demande.",
  },
];

// ── Schema.org HowTo ──────────────────────────────────────────────────────
const schemaHowTo = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "Comment commander des produits Forever Living en France",
  description:
    "Étapes pour commander vos produits Forever Living en France via la boutique en ligne, par téléphone ou par e-mail.",
  step: etapes.map((e, i) => ({
    "@type": "HowToStep",
    position: i + 1,
    name: e.titre,
    text: e.texte,
  })),
};

// ── Schema.org FAQPage ────────────────────────────────────────────────────
const schemaFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, r }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: r },
  })),
};
---

<Layout
  title="Commander des produits Forever Living en France | Esprit Aloé"
  description="Commandez vos produits sur la boutique officielle Forever Living. Rafael Avenard vous accompagne par téléphone ou e-mail pour préparer votre premier achat."
  canonical="https://espritaloe.fr/commander/"
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaHowTo)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} slot="head" />

  <Header />

  <!-- ══════════════════════════════════════════
       EN-TÊTE
  ══════════════════════════════════════════ -->
  <section class="bg-gradient-to-br from-aloe-50 via-cream to-sand py-16">
    <div class="mx-auto max-w-6xl px-6">
      <nav class="text-xs text-aloe-400 mb-6" aria-label="Fil d'Ariane">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-aloe-600 transition-colors">Accueil</a></li>
          <li>›</li>
          <li class="text-aloe-700 font-medium">Commander</li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-block rounded-full bg-aloe-100 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-aloe-700 mb-6">
          Boutique Forever Living — France
        </span>
        <h1 class="text-5xl md:text-6xl text-aloe-900 leading-tight mb-6">
          Comment commander<br />
          <span class="italic text-aloe-500">vos produits ?</span>
        </h1>
        <p class="text-xl text-aloe-700 leading-relaxed max-w-2xl mb-8">
          Commandez sur la boutique Forever Living ou contactez Rafael pour préparer votre achat.
          Vous pouvez <a href="/a-propos/" class="underline underline-offset-4 hover:text-aloe-900">faire connaissance avec Rafael Avenard, distributeur indépendant Forever Living</a>,
          avant votre première commande.
        </p>
        <a
          href={boutiqueUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-aloe-600 px-8 py-4 text-sm font-semibold text-cream hover:bg-aloe-700 transition-colors"
        >
          🛒 Ouvrir la boutique Forever France
        </a>
        <p class="mt-3 text-sm text-aloe-600">
          Vous poursuivrez votre commande sur le site officiel Forever Living dans un nouvel onglet.
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       3 MODES DE COMMANDE
  ══════════════════════════════════════════ -->
  <section class="bg-sand/50 py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-14">
        <span class="text-xs font-semibold uppercase tracking-widest text-aloe-500">Choisissez votre façon</span>
        <h2 class="text-4xl text-aloe-900 mt-2">Trois façons de commander</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {modesCommande.map((m) => (
          <div class="rounded-2xl bg-white border border-aloe-100 p-8 flex flex-col relative">
            {m.badge && (
              <span class="absolute -top-3 left-8 rounded-full bg-aloe-600 px-4 py-1 text-xs font-semibold text-cream">
                {m.badge}
              </span>
            )}
            <span class="text-3xl mb-4">{m.icon}</span>
            <h3 class="text-xl font-semibold text-aloe-800 mb-3">{m.titre}</h3>
            <p class="text-sm text-aloe-600 leading-relaxed mb-5">{m.description}</p>
            <ul class="space-y-2 mb-8 flex-1">
              {m.avantages.map((av) => (
                <li class="flex items-start gap-2 text-sm text-aloe-700">
                  <span class="text-aloe-500 mt-0.5">✓</span>
                  <span>{av}</span>
                </li>
              ))}
            </ul>
            <a
              href={m.ctaUrl}
              target={m.ctaUrl.startsWith("http") ? "_blank" : undefined}
              rel={m.ctaUrl.startsWith("http") ? "noopener noreferrer" : undefined}
              class="inline-flex items-center justify-center gap-2 rounded-full bg-aloe-600 px-6 py-3 text-sm font-semibold text-cream hover:bg-aloe-700 transition-colors text-center"
            >
              {m.cta}
            </a>
            {m.ctaUrl.startsWith("http") && (
              <p class="mt-3 text-xs text-aloe-600 text-center">Site officiel Forever Living · Nouvel onglet</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       ÉTAPES HowTo
  ══════════════════════════════════════════ -->
  <section class="bg-cream py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-14">
        <span class="text-xs font-semibold uppercase tracking-widest text-aloe-500">Processus de commande</span>
        <h2 class="text-4xl text-aloe-900 mt-2">En 4 étapes simples</h2>
      </div>
      <ol class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {etapes.map((e) => (
          <li class="rounded-2xl bg-white border border-aloe-100 p-7 flex flex-col">
            <span class="text-3xl mb-4">{e.icon}</span>
            <span class="text-xs font-semibold text-aloe-400 tracking-widest mb-2">Étape {e.numero}</span>
            <h3 class="text-lg font-semibold text-aloe-800 mb-3 leading-snug">{e.titre}</h3>
            <p class="text-sm text-aloe-600 leading-relaxed flex-1">{e.texte}</p>
            {e.lien && (
              <a
                href={e.lien}
                class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-aloe-600 hover:text-aloe-800 transition-colors"
              >
                {e.labelLien} →
              </a>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       BANDEAU LIVRAISON (rappel synthétique)
  ══════════════════════════════════════════ -->
  <section class="bg-aloe-800 text-cream py-14">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-10">
        <h2 class="text-3xl text-cream">Livraison et retours</h2>
        <p class="text-aloe-200 mt-2 text-sm">Vérifiez les modalités applicables à votre commande dans la boutique Forever.</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-6 max-w-3xl mx-auto text-center">
        <div class="rounded-2xl bg-aloe-700/50 p-6">
          <span class="text-3xl block mb-3">📦</span>
          <p class="font-semibold text-cream text-sm mb-1">Mode de réception</p>
          <p class="text-xs text-aloe-200">Consultez les options proposées pour votre adresse.</p>
        </div>
        <div class="rounded-2xl bg-aloe-700/50 p-6">
          <span class="text-3xl block mb-3">🚚</span>
          <p class="font-semibold text-cream text-sm mb-1">Frais et délais</p>
          <p class="text-xs text-aloe-200">Vérifiez les frais de livraison et le total avant de valider.</p>
        </div>
        <div class="rounded-2xl bg-aloe-700/50 p-6">
          <span class="text-3xl block mb-3">↩️</span>
          <p class="font-semibold text-cream text-sm mb-1">Besoin d'aide après l'achat ?</p>
          <p class="text-xs text-aloe-200">Contactez Rafael avec votre référence de commande.</p>
        </div>
      </div>
      <div class="text-center mt-8">
        <a
          href="/livraison/"
          class="inline-flex items-center gap-2 rounded-full border border-aloe-400 px-6 py-3 text-sm font-semibold text-cream hover:bg-aloe-700 transition-colors"
        >
          Voir tous les détails livraison →
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       FAQ
  ══════════════════════════════════════════ -->
  <section class="bg-cream py-20">
    <div class="mx-auto max-w-3xl px-6">
      <div class="text-center mb-12">
        <h2 class="text-4xl text-aloe-900">Questions fréquentes</h2>
        <p class="text-aloe-500 mt-3 text-sm">
          Une question non listée ? Contactez Rafael au
          <a href="tel:+33677352226" class="underline text-aloe-600">06 77 35 22 26</a>.
        </p>
      </div>
      <dl class="space-y-4">
        {faq.map(({ q, r }) => (
          <div class="rounded-2xl bg-white border border-aloe-100 p-6">
            <dt class="font-semibold text-aloe-800 mb-2">{q}</dt>
            <dd class="text-sm text-aloe-600 leading-relaxed">{r}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       CTA FINAL
  ══════════════════════════════════════════ -->
  <section class="bg-gradient-to-br from-aloe-50 via-cream to-sand py-16">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl text-aloe-900 mb-4">Prêt(e) à passer commande ?</h2>
      <p class="text-aloe-600 leading-relaxed mb-8 text-lg">
        Ouvrez la boutique officielle Forever Living pour finaliser votre achat,
        ou contactez Rafael pour un conseil avant de choisir.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href={boutiqueUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-aloe-600 px-8 py-4 text-sm font-semibold text-cream hover:bg-aloe-700 transition-colors"
        >
          🛒 Boutique officielle Forever
        </a>
        <a
          href="tel:+33677352226"
          class="inline-flex items-center gap-2 rounded-full border border-aloe-300 px-8 py-4 text-sm font-semibold text-aloe-700 hover:bg-aloe-50 transition-colors"
        >
          📞 06 77 35 22 26
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 rounded-full border border-aloe-300 px-8 py-4 text-sm font-semibold text-aloe-700 hover:bg-aloe-50 transition-colors"
        >
          ✉️ Nous écrire
        </a>
      </div>
      <p class="mt-4 text-sm text-aloe-600">Le bouton boutique ouvre le site Forever Living dans un nouvel onglet.</p>
    </div>
  </section>

  <Footer />
</Layout>
