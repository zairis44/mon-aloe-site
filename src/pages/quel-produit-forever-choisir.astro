---
/**
 * src/pages/quel-produit-forever-choisir.astro
 * Page « Trouver mon produit » : on part du besoin, pas du catalogue.
 * Données : src/data/besoins.ts (BESOINS) + collections produits et blog.
 * Zéro JS. Pas de prix ici (ils vivent dans les fiches).
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { BESOINS } from '../data/besoins';
import { LIBELLES } from '../data/maillage';

const produits = await getCollection('produits');
const parSlug = new Map(produits.map((p) => [(p.data as any).slug as string, p.data as any]));
const articles = await getCollection('blog', ({ data }) => !data.draft);
const articleParId = new Map(articles.map((a) => [a.id, a.data]));

const sections = BESOINS.map((b) => ({
  ...b,
  cartes: b.produits.map(([slug, phrase]) => {
    const p = parSlug.get(slug);
    if (!p) throw new Error(`besoins.ts : la fiche « ${slug} » (besoin « ${b.id} ») n'existe pas.`);
    return { slug, phrase, label: LIBELLES[slug] ?? p.name, nom: p.name as string, image: p.image as string | undefined };
  }),
  articlesLies: b.guides.map((id) => {
    const a = articleParId.get(id);
    if (!a) throw new Error(`besoins.ts : l'article « ${id} » (besoin « ${b.id} ») n'existe pas.`);
    return { id, titre: a.title as string };
  }),
}));

const titre = 'Quel produit Forever choisir ? Par besoin | Esprit Aloé';
const description =
  'Quel produit Forever Living choisir ? Digestion, énergie, sport, peau, programmes : trouvez la boisson, le soin ou le programme qui correspond à votre besoin.';

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://espritaloe.fr/' },
    { '@type': 'ListItem', position: 2, name: 'Trouver mon produit', item: 'https://espritaloe.fr/quel-produit-forever-choisir/' },
  ],
};
---

<Layout title={titre} description={description} canonical="https://espritaloe.fr/quel-produit-forever-choisir/">
  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} slot="head" />
  <Header />

  <section class="bg-gradient-to-br from-aloe-50 via-cream to-sand py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <nav class="text-xs text-aloe-500 mb-6" aria-label="Fil d'Ariane">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-aloe-700 transition-colors">Accueil</a></li>
          <li aria-hidden="true">›</li>
          <li class="text-aloe-700 font-medium" aria-current="page">Trouver mon produit</li>
        </ol>
      </nav>
      <h1 class="text-4xl md:text-5xl text-aloe-900 mb-4">Quel produit Forever choisir ?</h1>
      <p class="text-lg text-aloe-600 max-w-2xl mb-8">
        La gamme Forever Living compte plus de trente produits. Plutôt que de tout parcourir, partez de ce que
        vous cherchez : je vous indique par où commencer, avec les précautions à connaître.
      </p>
      <ul class="flex flex-wrap gap-3" aria-label="Aller à un besoin">
        {sections.map((s) => (
          <li>
            <a
              href={`#${s.id}`}
              class="inline-flex rounded-full border border-aloe-200 bg-white px-4 py-2 text-sm font-medium text-aloe-700 hover:border-aloe-400 hover:text-aloe-900 transition-colors"
            >
              {s.court}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {sections.map((s, i) => (
    <section id={s.id} class={`py-14 md:py-16 scroll-mt-24 ${i % 2 === 0 ? 'bg-cream' : 'bg-white'}`} aria-labelledby={`${s.id}-titre`}>
      <div class="mx-auto max-w-6xl px-6">
        <h2 id={`${s.id}-titre`} class="text-2xl md:text-3xl text-aloe-900 mb-3">{s.titre}</h2>
        <p class="text-aloe-600 leading-relaxed max-w-3xl mb-8">{s.intro}</p>

        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4 mb-6">
          {s.cartes.map((c) => (
            <li>
              <a
                href={`/produits/${c.slug}/`}
                class="group flex h-full flex-col rounded-2xl border border-aloe-100 bg-white p-5 transition-all hover:border-aloe-300 hover:shadow-sm"
              >
                {c.image && (
                  <div class="mb-4 flex h-32 items-center justify-center rounded-xl bg-cream p-2">
                    <img src={c.image} alt={c.nom} width="140" height="128" loading="lazy" decoding="async" class="h-full w-full object-contain" />
                  </div>
                )}
                <span class="mb-1 text-sm font-semibold leading-snug text-aloe-800 group-hover:text-aloe-600">{c.label}</span>
                <span class="text-xs leading-relaxed text-aloe-500 mb-3">{c.phrase}</span>
                <span class="mt-auto text-xs font-semibold text-aloe-600">Voir la fiche →</span>
              </a>
            </li>
          ))}
        </ul>

        {s.attention && (
          <p class="rounded-xl border border-aloe-100 bg-aloe-50 px-5 py-4 text-sm text-aloe-700 max-w-3xl mb-6">
            <strong class="font-semibold">À savoir : </strong>{s.attention}
          </p>
        )}

        {(s.articlesLies.length > 0 || s.lienExtra) && (
          <ul class="space-y-2 text-sm">
            {s.articlesLies.map((a) => (
              <li>
                <a href={`/blog/${a.id}/`} class="font-semibold text-aloe-600 hover:text-aloe-800 transition-colors">
                  {a.titre} →
                </a>
              </li>
            ))}
            {s.lienExtra && (
              <li>
                <a href={s.lienExtra.href} class="font-semibold text-aloe-600 hover:text-aloe-800 transition-colors">
                  {s.lienExtra.label} →
                </a>
              </li>
            )}
          </ul>
        )}
      </div>
    </section>
  ))}

  <section class="bg-sand py-16">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl text-aloe-900 mb-4">Un doute sur votre situation ?</h2>
      <p class="text-aloe-600 mb-6">
        Dites-moi ce que vous cherchez, je vous réponds honnêtement, y compris pour vous dire qu’un produit
        n’est pas fait pour vous.
      </p>
      <a href="/contact/" class="rounded-full bg-aloe-600 px-8 py-3.5 text-sm font-semibold text-cream hover:bg-aloe-700 transition-colors">
        Me poser une question
      </a>
    </div>
  </section>

  <Footer />
</Layout>
