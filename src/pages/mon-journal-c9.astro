---
/**
 * src/pages/mon-journal-c9.astro
 * Journal de bord personnel — cure C9 suivie en direct par Rafael
 * Objectif SEO : E-E-A-T (expérience vécue), longue traîne "avis C9 Forever"
 * Objectif conversion : preuve sociale authentique → fiches produit C9
 * Schema.org : BlogPosting + BreadcrumbList
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection, render } from 'astro:content';

const tousLesJournaux = await getCollection('journal');
const entry = tousLesJournaux.find((e) => e.data.slug === 'mon-journal-c9');

if (!entry) {
  throw new Error("Entrée introuvable : aucun fichier dans src/content/journal/ n'a slug: \"mon-journal-c9\"");
}

const { Content } = await render(entry);
const d = entry.data;

const TOTAL_JOURS = 9;
const jourActuel = d.jours.length; // nombre de jours déjà remplis
const estTermine = d.statut === 'termine';
const numerosJours = Array.from({ length: TOTAL_JOURS }, (_, i) => i + 1);

const pageUrl = 'https://espritaloe.fr/mon-journal-c9/';
const imageCouverture = d.imageCouverture ?? '/og-image.jpg';

const seoTitle = d.seoTitle ?? `${d.titre} | Esprit Aloé`;
const seoDescription = d.seoDescription ??
  "Mon ressenti, jour après jour, pendant les 9 jours du programme C9 Forever — sans filtre, comme un vrai journal.";

const schemaArticle = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": pageUrl,
  headline: d.titre,
  description: seoDescription,
  author: {
    "@type": "Person",
    name: "Rafael Avenard",
    jobTitle: "Distributeur Indépendant Forever Living Products",
    url: "https://espritaloe.fr/a-propos/",
  },
  datePublished: d.dateDebut.toISOString(),
  dateModified: new Date().toISOString(),
  image: `https://espritaloe.fr${imageCouverture}`,
  mainEntityOfPage: pageUrl,
  publisher: {
    "@type": "Organization",
    name: "Esprit Aloé",
    url: "https://espritaloe.fr",
  },
};

const schemaBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: "https://espritaloe.fr/" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://espritaloe.fr/blog/" },
    { "@type": "ListItem", position: 3, name: d.titre, item: pageUrl },
  ],
};

const labelProgramme = d.programme === 'vanille-peche' ? 'Vanille-Pêche' : 'Chocolat-Pêche';
const slugProduitLie = d.programme === 'vanille-peche'
  ? 'programme-c9-forever-vanille-peche'
  : 'programme-c9-forever-chocolat-peche';

// Produit lié — récupéré directement depuis la collection produits
// (même image et prix que la fiche produit, pas de nouveau fichier à gérer)
const tousLesProduits = await getCollection('produits');
const produitC9 = tousLesProduits.find((p) => p.data.slug === slugProduitLie);

const mesures = d.mesurationsDepart;
const nbMesures = [
  mesures.poids, mesures.tourPoitrine, mesures.tourNombril, mesures.tourTaille,
  mesures.tourHanches, mesures.tourCuisse, mesures.tourBras,
].filter((v) => v != null).length;

// ── Les 3 phases officielles du programme C9 ──────────────────
const PHASES = [
  {
    numero: 1,
    nom: 'Nettoyage',
    jours: [1, 2],
    description: "Les deux journées les plus strictes : pas de repas solide, on laisse le corps éliminer.",
    couleurFond: '#EEF6FF',
    couleurBordure: '#93B8DE',
    couleurTexte: '#1E4976',
    couleurOnglet: '#3A72AB',
  },
  {
    numero: 2,
    nom: 'Adaptation',
    jours: [3, 4, 5, 6],
    description: "Un repas équilibré est réintroduit chaque jour. Le corps s'ajuste, l'énergie remonte.",
    couleurFond: '#F3ECFA',
    couleurBordure: '#C9AEE0',
    couleurTexte: '#4A2E6E',
    couleurOnglet: '#7A4FA0',
  },
  {
    numero: 3,
    nom: 'Stabilisation',
    jours: [7, 8, 9],
    description: "La dernière ligne droite : on consolide les acquis et on prépare l'après-cure.",
    couleurFond: '#EDF7F0',
    couleurBordure: '#9CCBA9',
    couleurTexte: '#215B33',
    couleurOnglet: '#3E8C57',
  },
];

function phaseDuJour(num: number) {
  return PHASES.find((p) => p.jours.includes(num)) ?? PHASES[0];
}
---

<Layout
  title={seoTitle}
  description={seoDescription}
  image={imageCouverture}
  canonical={pageUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} slot="head" />

  <Header />

  <!-- ══════════════════════════════════════════════
       EN-TÊTE
  ══════════════════════════════════════════════ -->
  <header class="bg-gradient-to-b from-[#4E2E6E] to-[#3B2354] py-16">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <nav class="text-xs text-aloe-400 mb-8" aria-label="Fil d'Ariane">
        <ol class="flex items-center justify-center gap-2">
          <li><a href="/" class="hover:text-aloe-200 transition-colors">Accueil</a></li>
          <li class="text-aloe-600">›</li>
          <li><a href="/blog/" class="hover:text-aloe-200 transition-colors">Blog</a></li>
          <li class="text-aloe-600">›</li>
          <li class="text-aloe-300">Mon journal C9</li>
        </ol>
      </nav>

      <span class:list={[
        "inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-semibold uppercase tracking-widest mb-6",
        estTermine ? "bg-aloe-700 text-aloe-200" : "bg-clay text-cream"
      ]}>
        {estTermine ? "✓ Cure terminée" : "🔴 En cours"} — Jour {jourActuel}/{TOTAL_JOURS}
      </span>

      <h1 class="text-3xl md:text-4xl text-cream leading-tight mb-6 font-display">{d.titre}</h1>
      <p class="text-lg text-aloe-200 leading-relaxed mb-8">{seoDescription}</p>

      <div class="flex items-center justify-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-[#7A4FA0] flex items-center justify-center text-cream font-bold text-sm flex-shrink-0">RA</div>
        <div class="text-left">
          <p class="text-sm font-semibold text-cream">Rafael Avenard — ma 10e cure C9</p>
          <p class="text-xs text-aloe-400">Programme {labelProgramme} — démarré le {d.dateDebut.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
        </div>
      </div>
    </div>
  </header>

  <!-- ══════════════════════════════════════════════
       INTRO PERSONNELLE (corps markdown du fichier)
  ══════════════════════════════════════════════ -->
  <section class="bg-cream py-14">
    <div class="mx-auto max-w-2xl px-6 prose prose-aloe">
      <Content />
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       MON HISTOIRE
  ══════════════════════════════════════════════ -->
  {d.monHistoire?.texte && (
    <section class="bg-[#3B2354] py-16">
      <div class="mx-auto max-w-2xl px-6">
        <h2 class="text-2xl text-cream mb-6 font-display text-center">Mon histoire avec le C9</h2>
        <div class="rounded-3xl bg-[#4E2E6E]/50 border border-[#7A4FA0] p-8">
          <p class="text-[#EADFF5] leading-relaxed whitespace-pre-line">{d.monHistoire.texte}</p>
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════════════════════════════════════
       MENSURATIONS DE DÉPART
  ══════════════════════════════════════════════ -->
  <section class="bg-sand/50 py-14">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-2xl text-aloe-900 mb-2 font-display text-center">Avant de commencer</h2>
      <p class="text-sm text-aloe-500 text-center mb-8">Mon point de départ, pour que tu puisses suivre l'évolution</p>

      {nbMesures > 0 && (
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {mesures.poids != null && (
            <div class="rounded-2xl bg-white border border-aloe-100 p-5 text-center">
              <p class="text-2xl font-display text-aloe-700">{mesures.poids} kg</p>
              <p class="text-xs text-aloe-400 mt-1">Poids</p>
            </div>
          )}
          {mesures.tourPoitrine != null && (
            <div class="rounded-2xl bg-white border border-aloe-100 p-5 text-center">
              <p class="text-2xl font-display text-aloe-700">{mesures.tourPoitrine} cm</p>
              <p class="text-xs text-aloe-400 mt-1">Tour de poitrine</p>
            </div>
          )}
          {mesures.tourNombril != null && (
            <div class="rounded-2xl bg-white border border-aloe-100 p-5 text-center">
              <p class="text-2xl font-display text-aloe-700">{mesures.tourNombril} cm</p>
              <p class="text-xs text-aloe-400 mt-1">Tour de nombril</p>
            </div>
          )}
          {mesures.tourTaille != null && (
            <div class="rounded-2xl bg-white border border-aloe-100 p-5 text-center">
              <p class="text-2xl font-display text-aloe-700">{mesures.tourTaille} cm</p>
              <p class="text-xs text-aloe-400 mt-1">Tour de taille</p>
            </div>
          )}
          {mesures.tourHanches != null && (
            <div class="rounded-2xl bg-white border border-aloe-100 p-5 text-center">
              <p class="text-2xl font-display text-aloe-700">{mesures.tourHanches} cm</p>
              <p class="text-xs text-aloe-400 mt-1">Tour de hanches</p>
            </div>
          )}
          {mesures.tourCuisse != null && (
            <div class="rounded-2xl bg-white border border-aloe-100 p-5 text-center">
              <p class="text-2xl font-display text-aloe-700">{mesures.tourCuisse} cm</p>
              <p class="text-xs text-aloe-400 mt-1">Tour de cuisse</p>
            </div>
          )}
          {mesures.tourBras != null && (
            <div class="rounded-2xl bg-white border border-aloe-100 p-5 text-center">
              <p class="text-2xl font-display text-aloe-700">{mesures.tourBras} cm</p>
              <p class="text-xs text-aloe-400 mt-1">Tour de bras</p>
            </div>
          )}
          {mesures.energie != null && (
            <div class="rounded-2xl bg-white border border-aloe-100 p-5 text-center">
              <p class="text-2xl font-display text-aloe-700">{mesures.energie}/10</p>
              <p class="text-xs text-aloe-400 mt-1">Énergie</p>
            </div>
          )}
        </div>
      )}

      {mesures.vetementReference && (
        <div class="mt-6 rounded-2xl bg-white border border-aloe-100 p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-aloe-400 mb-2">👖 Mon repère vêtement</p>
          <p class="text-aloe-700 leading-relaxed">{mesures.vetementReference}</p>
        </div>
      )}

      {mesures.motivation && (
        <div class="mt-4 rounded-2xl bg-white border border-aloe-100 p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-aloe-400 mb-2">Pourquoi je me lance cette fois</p>
          <p class="text-aloe-700 leading-relaxed">{mesures.motivation}</p>
        </div>
      )}
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       JOURNAL JOUR PAR JOUR — onglets CSS pur, zéro JS
  ══════════════════════════════════════════════ -->
  <section class="bg-cream py-16">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-2xl text-aloe-900 mb-8 font-display text-center">Mon journal, jour par jour</h2>

      <div class="c9-tabs">
        <!-- Radios (cachés) -->
        {numerosJours.map((num) => {
          const jourDispo = d.jours.some((j) => j.numero === num);
          return (
            <input
              type="radio"
              name="c9-jour"
              id={`c9-radio-${num}`}
              class="c9-radio sr-only"
              checked={num === jourActuel}
              disabled={!jourDispo}
            />
          );
        })}

        <!-- Étiquettes sur une seule ligne, colorées par phase -->
        <div class="c9-labels mb-4 flex flex-wrap items-center justify-center gap-2">
          {numerosJours.map((num) => {
            const jourDispo = d.jours.some((j) => j.numero === num);
            const phase = phaseDuJour(num);
            const debutDePhase = phase.jours[0] === num;
            return (
              <>
                {debutDePhase && num !== 1 && (
                  <span class="text-aloe-200 select-none px-1">|</span>
                )}
                <label
                  for={`c9-radio-${num}`}
                  class:list={["c9-label rounded-full px-4 py-2 text-sm font-semibold border transition-colors", !jourDispo && "cursor-not-allowed opacity-40"]}
                  style={jourDispo
                    ? `border-color: ${phase.couleurBordure}; color: ${phase.couleurTexte}; cursor: pointer;`
                    : `border-color: #E5E5E5; color: #BBB;`}
                >
                  {jourDispo ? `Jour ${num}` : `🔒 J${num}`}
                </label>
              </>
            );
          })}
        </div>

        <!-- Légende des phases -->
        <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 mb-8">
          {PHASES.map((phase) => (
            <span class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-widest" style={`color: ${phase.couleurOnglet}`}>
              <span class="w-2.5 h-2.5 rounded-full" style={`background-color: ${phase.couleurOnglet}`}></span>
              Phase {phase.numero} — {phase.nom}
            </span>
          ))}
        </div>

        <!-- Panneaux -->
        <div class="c9-panels">
          {d.jours.map((jour) => {
            const phase = phaseDuJour(jour.numero);
            return (
            <div
              id={`c9-panel-${jour.numero}`}
              class="c9-panel rounded-3xl border p-8"
              style={`background-color: ${phase.couleurFond}; border-color: ${phase.couleurBordure};`}
            >
              <!-- Bandeau de phase -->
              <div
                class="rounded-2xl px-5 py-3 mb-6 text-center"
                style={`background-color: ${phase.couleurOnglet};`}
              >
                <p class="text-[11px] font-semibold uppercase tracking-widest text-white/80 mb-1">
                  Phase {phase.numero} sur 3 — Jours {phase.jours[0]} à {phase.jours[phase.jours.length - 1]}
                </p>
                <p class="text-lg font-display text-white leading-tight">{phase.nom}</p>
                <p class="text-xs text-white/80 mt-1.5 leading-relaxed">{phase.description}</p>
              </div>

              <div class="flex items-center justify-between flex-wrap gap-3 mb-5">
                <h3 class="text-xl font-display" style={`color: ${phase.couleurTexte}`}>{jour.titre}</h3>
                <span class="text-xs text-aloe-400">
                  {jour.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' })}
                </span>
              </div>

              <div class="flex flex-wrap gap-4 mb-6">
                {jour.poids != null && (
                  <span class="rounded-full bg-white/70 px-4 py-1.5 text-sm" style={`color: ${phase.couleurTexte}`}>⚖️ {jour.poids} kg</span>
                )}
                {jour.note != null && (
                  <span class="rounded-full bg-white/70 px-4 py-1.5 text-sm" style={`color: ${phase.couleurTexte}`}>
                    {'⭐'.repeat(jour.note)}{'☆'.repeat(5 - jour.note)}
                  </span>
                )}
              </div>

              <p class="text-aloe-700 leading-relaxed mb-6">{jour.ressenti}</p>

              {jour.photos.length > 0 && (
                <div class:list={["grid gap-3 mb-6", jour.photos.length > 1 ? "grid-cols-2" : "grid-cols-1"]}>
                  {jour.photos.map((photo) => (
                    <img
                      src={photo.src}
                      alt={photo.legende ?? `${jour.titre} — programme C9 Forever, journal de Rafael Avenard`}
                      class="w-auto max-h-[420px] mx-auto rounded-2xl border border-white"
                      loading="lazy"
                    />
                  ))}
                </div>
              )}

              <div class="grid md:grid-cols-2 gap-4 mb-6">
                {jour.positifs.length > 0 && (
                  <div class="rounded-2xl bg-white/70 p-5">
                    <p class="text-xs font-semibold uppercase tracking-widest mb-3" style={`color: ${phase.couleurTexte}`}>👍 Ce qui va bien</p>
                    <ul class="space-y-2">
                      {jour.positifs.map((p) => (
                        <li class="text-sm text-aloe-700 flex gap-2"><span>✓</span><span>{p}</span></li>
                      ))}
                    </ul>
                  </div>
                )}
                {jour.negatifs.length > 0 && (
                  <div class="rounded-2xl bg-white/70 p-5">
                    <p class="text-xs font-semibold uppercase tracking-widest mb-3" style={`color: ${phase.couleurTexte}`}>👎 Ce qui est difficile</p>
                    <ul class="space-y-2">
                      {jour.negatifs.map((n) => (
                        <li class="text-sm text-aloe-700 flex gap-2"><span>−</span><span>{n}</span></li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>

              {jour.infoDuJour && (
                <div class="rounded-2xl bg-white border p-6" style={`border-color: ${phase.couleurBordure};`}>
                  <p class="text-xs font-semibold uppercase tracking-widest mb-3" style={`color: ${phase.couleurOnglet}`}>
                    💡 L'info du jour — {jour.infoDuJour.titre}
                  </p>
                  <p class="text-sm text-aloe-700 leading-relaxed">{jour.infoDuJour.texte}</p>
                  {jour.infoDuJour.photo && (
                    <img
                      src={jour.infoDuJour.photo}
                      alt={`${jour.infoDuJour.titre} — programme C9 Forever Living`}
                      class="mt-4 w-auto max-h-[300px] mx-auto rounded-xl border"
                      style={`border-color: ${phase.couleurBordure};`}
                      loading="lazy"
                    />
                  )}
                </div>
              )}
            </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       SYNTHÈSE FINALE (visible seulement une fois remplie)
  ══════════════════════════════════════════════ -->
  <section class="bg-gradient-to-br from-aloe-50 via-cream to-sand py-16">
    <div class="mx-auto max-w-3xl px-6">
      {d.synthese?.avisGlobal ? (
        <>
          <div class="text-center mb-10">
            <span class="inline-flex items-center gap-2 rounded-full bg-[#3E8C57] px-5 py-2 text-xs font-semibold uppercase tracking-widest text-white mb-5">
              ✓ Cure terminée
            </span>
            <h2 class="text-3xl md:text-4xl text-aloe-900 font-display">Mon bilan après 9 jours</h2>
          </div>

          <!-- Résultats chiffrés -->
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-10">
            {d.synthese.poidsFinal != null && d.synthese.poidsPerdu != null && (
              <div class="col-span-2 md:col-span-3 rounded-3xl bg-[#3E8C57] p-8">
                <div class="flex flex-col sm:flex-row items-center justify-center gap-8">
                  <div class="text-center">
                    <p class="text-xs font-semibold uppercase tracking-widest text-white/70 mb-2">Poids final</p>
                    <p class="text-5xl font-display text-white mb-1">{d.synthese.poidsFinal} kg</p>
                    <p class="text-sm text-white/90">
                      soit −{d.synthese.poidsPerdu} kg depuis le Jour 1
                      {mesures.poids != null && ` (${mesures.poids} kg)`}
                    </p>
                  </div>
                  {d.synthese.photoBalance && (
                    <img
                      src={d.synthese.photoBalance}
                      alt="Balance avant et après le programme C9 Forever : 82,4 kg puis 79,7 kg"
                      class="w-auto max-h-[220px] rounded-2xl border-2 border-white/30"
                      loading="lazy"
                    />
                  )}
                </div>
              </div>
            )}
            {d.synthese.tourPoitrinePerdu != null && d.synthese.tourPoitrinePerdu > 0 && (
              <div class="rounded-2xl bg-white border border-aloe-100 p-5 text-center">
                <p class="text-2xl font-display text-aloe-700">−{d.synthese.tourPoitrinePerdu} cm</p>
                <p class="text-xs text-aloe-400 mt-1">Tour de poitrine</p>
              </div>
            )}
            {d.synthese.tourNombrilPerdu != null && d.synthese.tourNombrilPerdu > 0 && (
              <div class="rounded-2xl bg-white border border-aloe-100 p-5 text-center">
                <p class="text-2xl font-display text-aloe-700">−{d.synthese.tourNombrilPerdu} cm</p>
                <p class="text-xs text-aloe-400 mt-1">Tour de nombril</p>
              </div>
            )}
            {d.synthese.tourTaillePerdu != null && d.synthese.tourTaillePerdu > 0 && (
              <div class="rounded-2xl bg-white border border-aloe-100 p-5 text-center">
                <p class="text-2xl font-display text-aloe-700">−{d.synthese.tourTaillePerdu} cm</p>
                <p class="text-xs text-aloe-400 mt-1">Tour de taille</p>
              </div>
            )}
            {d.synthese.tourBrasPerdu != null && d.synthese.tourBrasPerdu > 0 && (
              <div class="rounded-2xl bg-white border border-aloe-100 p-5 text-center">
                <p class="text-2xl font-display text-aloe-700">−{d.synthese.tourBrasPerdu} cm</p>
                <p class="text-xs text-aloe-400 mt-1">Tour de bras</p>
              </div>
            )}
            {d.synthese.tourCuissePerdu === 0 && (
              <div class="rounded-2xl bg-aloe-50 border border-aloe-200 p-5 text-center">
                <p class="text-2xl font-display text-aloe-700">=</p>
                <p class="text-xs text-aloe-500 mt-1">Tour de cuisse inchangé</p>
              </div>
            )}
          </div>

          <!-- Avis global -->
          <div class="rounded-3xl bg-white border border-aloe-100 p-8 mb-6">
            <p class="text-aloe-700 leading-relaxed whitespace-pre-line">{d.synthese.avisGlobal}</p>
          </div>

          <!-- Positifs / négatifs -->
          <div class="grid md:grid-cols-2 gap-4 mb-6">
            {d.synthese.pointsPositifs.length > 0 && (
              <div class="rounded-2xl bg-aloe-50 border border-aloe-100 p-6">
                <p class="text-xs font-semibold uppercase tracking-widest text-aloe-600 mb-4">👍 Ce que je retiens</p>
                <ul class="space-y-2.5">
                  {d.synthese.pointsPositifs.map((p) => (
                    <li class="text-sm text-aloe-700 flex gap-2"><span>✓</span><span>{p}</span></li>
                  ))}
                </ul>
              </div>
            )}
