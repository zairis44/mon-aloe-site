---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

// ── Produits phares depuis la collection (prix toujours justes) ─────────────
// Fallback statique si la collection est vide (développement)
let produitsPhares = [];
try {
  const collection = await getCollection('produits', ({ data }) => data.featured && data.disponible);
  produitsPhares = collection
    .sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0))
    .slice(0, 3)
    .map(p => ({
      nom: p.data.nom,
      desc: p.data.description,
      prix: `${p.data.prix.toFixed(2)} €`,
      slug: p.slug,
      tag: p.data.categorie === 'programmes-detox' ? 'Programme' :
           p.data.prix < 20 ? 'Petit prix' : 'Best-seller',
    }));
} catch (_) {}

// Fallback si collection vide
if (produitsPhares.length === 0) {
  produitsPhares = [
    {
      nom: "Forever Aloe Vera Gel",
      desc: "La pulpe pure à boire, 99,7% d'aloe vera stabilisé pour le confort digestif.",
      prix: "37,29 €",
      slug: "forever-pulpe-daloe-vera",
      tag: "Best-seller",
    },
    {
      nom: "Programme C9 — Détox 9 jours",
      desc: "Programme de 9 jours pour repartir sur de bonnes bases et se sentir léger.",
      prix: "152,42 €",
      slug: "programme-c9-forever-vanille-peche",
      tag: "Programme",
    },
    {
      nom: "Forever Freedom",
      desc: "Boisson aloe vera enrichie en glucosamine et MSM pour le confort articulaire.",
      prix: "50,89 €",
      slug: "forever-freedom-confort-articulaire",
      tag: "Articulations",
    },
  ];
}

const benefices = [
  {
    titre: "Hydratation profonde",
    texte: "L'aloe vera apaise et nourrit la peau en profondeur grâce à ses polysaccharides naturels.",
    lien: "/blog/aloe-vera-peau-beaute-bienfaits-forever/",
  },
  {
    titre: "Confort digestif",
    texte: "La pulpe soutient un transit équilibré et apaise les muqueuses intestinales.",
    lien: "/blog/aloe-vera-digestion-bienfaits/",
  },
  {
    titre: "Tonus & Immunité",
    texte: "Vitamines A, B, C et E pour accompagner vos défenses naturelles au quotidien.",
    lien: "/blog/aloe-vera-systeme-immunitaire-defenses-naturelles/",
  },
];

// Avis sans géolocalisation régionale
const avis = [
  {
    texte: "Je bois la pulpe d'aloe vera tous les matins depuis 3 mois, ma digestion s'est nettement améliorée.",
    auteur: "Sylvie M.",
    produit: "Forever Aloe Vera Gel",
  },
  {
    texte: "Le programme C9 m'a vraiment aidée à reprendre de bonnes habitudes. Conseils au top.",
    auteur: "Karim B.",
    produit: "Programme C9",
  },
  {
    texte: "Livraison rapide et produits de qualité. Je recommande sans hésiter.",
    auteur: "Élodie R.",
    produit: "Forever Freedom",
  },
];

// ── Schema.org FAQPage ─────────────────────────────────────────────────────
const schemaFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Comment commander des produits Forever Living en France ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Commandez via notre boutique en ligne sécurisée ou par téléphone au 06 77 35 22 26. Livraison en 24–72h partout en France.",
      },
    },
    {
      "@type": "Question",
      name: "Les produits Forever Living sont-ils certifiés ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Oui. Tous les produits sont certifiés IASC (International Aloe Science Council), Kosher et Halal, sans tests sur les animaux.",
      },
    },
    {
      "@type": "Question",
      name: "Qu'est-ce que le programme C9 Forever ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Le C9 est une cure détox de 9 jours à base d'Aloe Vera pour nettoyer l'organisme, relancer le métabolisme et perdre du poids naturellement.",
      },
    },
  ],
};
---

<Layout
  title="Produits Aloe Vera Forever Living — Distributeur France | Esprit Aloé"
  description="Découvrez et commandez les produits Aloe Vera Forever Living en France. Boissons, soins beauté, programmes détox C9 & DX4. Livraison 24-72h. Conseils personnalisés 7j/7."
  canonical="https://espritaloe.fr/"
>
  <!-- Schema.org FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} />

  <Header />

  <!-- ══════════════════════════════════════════════
       HERO — H1 avec mot-clé national
  ══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-aloe-50 via-cream to-sand"></div>
    <div class="absolute -right-20 -top-20 w-96 h-96 rounded-full bg-aloe-200/40 blur-3xl"></div>
    <div class="absolute -left-32 bottom-0 w-96 h-96 rounded-full bg-aloe-300/30 blur-3xl"></div>

    <div class="relative mx-auto max-w-6xl px-6 py-24 md:py-32 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <span class="inline-block rounded-full bg-aloe-100 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-aloe-700 mb-6">
          Distributeur Forever Living Products — France
        </span>

        <!-- H1 avec mot-clé principal ciblé -->
        <h1 class="text-5xl md:text-6xl leading-[1.05] text-aloe-900 mb-6">
          Produits Aloe Vera<br />
          <span class="italic text-aloe-500">Forever Living</span><br />
          pour votre bien-être
        </h1>

        <p class="text-lg text-aloe-700 leading-relaxed mb-8 max-w-md">
          Une gamme complète de boissons, soins et compléments à base d'aloe vera
          pur, certifiés IASC. Livrés partout en France en 24–72h.
        </p>

        <div class="flex flex-wrap gap-4 mb-8">
          <a href="/produits/" class="rounded-full bg-aloe-600 px-7 py-3.5 text-sm font-semibold text-cream hover:bg-aloe-700 transition-colors">
            Découvrir les produits
          </a>
          <a href="/blog/" class="rounded-full border border-aloe-300 px-7 py-3.5 text-sm font-semibold text-aloe-700 hover:bg-aloe-50 transition-colors">
            Conseils bien-être
          </a>
        </div>

        <!-- Signaux de confiance -->
        <ul class="flex flex-wrap gap-x-5 gap-y-2 text-xs text-aloe-600">
          <li>✓ Certifié IASC</li>
          <li>✓ Livraison offerte dès 150 €</li>
          <li>✓ Conseiller 7j/7</li>
          <li>✓ Satisfait ou remboursé 30j</li>
        </ul>
      </div>

      <div class="relative">
        <div class="aspect-square rounded-[2.5rem] bg-gradient-to-br from-aloe-400 to-aloe-700 flex items-center justify-center shadow-2xl shadow-aloe-900/20">
          <span class="text-[10rem]">🌿</span>
        </div>
        <div class="absolute -bottom-6 -left-6 bg-cream rounded-2xl px-5 py-4 shadow-xl">
          <p class="text-2xl font-display text-aloe-600">99,7%</p>
          <p class="text-xs text-aloe-500 uppercase tracking-wide">d'aloe vera pur</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       BÉNÉFICES — avec liens vers les articles blog
  ══════════════════════════════════════════════ -->
  <section class="bg-cream py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-3 gap-6">
        {benefices.map((b) => (
          <div class="rounded-2xl bg-white/60 border border-aloe-100 p-8">
            <h3 class="text-xl text-aloe-800 mb-2">{b.titre}</h3>
            <p class="text-sm text-aloe-600 leading-relaxed mb-3">{b.texte}</p>
            <a href={b.lien} class="text-xs font-semibold text-aloe-500 hover:text-aloe-700 transition-colors">
              En savoir plus →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       PRODUITS PHARES — prix depuis la collection
  ══════════════════════════════════════════════ -->
  <section class="bg-sand/50 py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-14">
        <span class="text-xs font-semibold uppercase tracking-widest text-aloe-500">Notre sélection</span>
        <h2 class="text-4xl text-aloe-900 mt-2">Produits phares</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {produitsPhares.map((p) => (
          <article class="group rounded-3xl bg-white border border-aloe-100 overflow-hidden hover:shadow-xl hover:shadow-aloe-900/10 transition-all">
            <div class="aspect-[4/3] bg-gradient-to-br from-aloe-50 to-aloe-100 flex items-center justify-center relative">
              <span class="text-7xl group-hover:scale-110 transition-transform">🌿</span>
              <span class="absolute top-4 left-4 rounded-full bg-aloe-600 px-3 py-1 text-[11px] font-semibold text-cream uppercase tracking-wide">
                {p.tag}
              </span>
            </div>
            <div class="p-6">
              <h3 class="text-xl text-aloe-800 mb-2">{p.nom}</h3>
              <p class="text-sm text-aloe-600 leading-relaxed mb-4">{p.desc}</p>
              <div class="flex items-center justify-between">
                <span class="text-lg font-display text-aloe-700">{p.prix}</span>
                <a href={`/produits/${p.slug}/`} class="text-sm font-semibold text-aloe-500 hover:text-aloe-700 transition-colors">
                  Voir le produit →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/produits/" class="rounded-full border border-aloe-300 px-8 py-3.5 text-sm font-semibold text-aloe-700 hover:bg-aloe-50 transition-colors">
          Voir toute la gamme (25 produits)
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       POURQUOI L'ALOE VERA
  ══════════════════════════════════════════════ -->
  <section class="bg-aloe-800 text-cream py-24">
    <div class="mx-auto max-w-5xl px-6 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-4xl text-cream mb-6">Pourquoi choisir l'aloe vera ?</h2>
        <p class="text-aloe-100 leading-relaxed mb-4">
          Utilisée depuis des millénaires, l'<em>Aloe Vera Barbadensis Miller</em> concentre
          vitamines, minéraux et acides aminés essentiels. Forever Living cultive son aloe vera
          sans pesticides et le stabilise à froid pour préserver toutes ses qualités.
        </p>
        <p class="text-aloe-100 leading-relaxed mb-6">
          De la pulpe à boire aux soins de la peau, chaque produit est certifié IASC
          et pensé pour vous accompagner vers un quotidien plus naturel.
        </p>
        <a href="/notre-aloe/" class="text-sm font-semibold text-aloe-300 hover:text-cream transition-colors">
          En savoir plus sur notre aloe vera →
        </a>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="rounded-2xl bg-aloe-700 p-6 text-center">
          <p class="text-3xl font-display text-cream">+40</p>
          <p class="text-xs text-aloe-200 uppercase tracking-wide mt-1">ans d'expertise</p>
        </div>
        <div class="rounded-2xl bg-aloe-700 p-6 text-center">
          <p class="text-3xl font-display text-cream">0</p>
          <p class="text-xs text-aloe-200 uppercase tracking-wide mt-1">pesticide</p>
        </div>
        <div class="rounded-2xl bg-aloe-700 p-6 text-center">
          <p class="text-3xl font-display text-cream">100%</p>
          <p class="text-xs text-aloe-200 uppercase tracking-wide mt-1">satisfait ou remboursé</p>
        </div>
        <div class="rounded-2xl bg-aloe-700 p-6 text-center">
          <p class="text-3xl font-display text-cream">24–72h</p>
          <p class="text-xs text-aloe-200 uppercase tracking-wide mt-1">livraison France</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       AVIS CLIENTS — sans géolocalisation régionale
  ══════════════════════════════════════════════ -->
  <section class="bg-cream py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-14">
        <span class="text-xs font-semibold uppercase tracking-widest text-aloe-500">Ils nous font confiance</span>
        <h2 class="text-4xl text-aloe-900 mt-2">Avis clients</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {avis.map((a) => (
          <figure class="rounded-2xl bg-white border border-aloe-100 p-8">
            <div class="text-clay text-lg mb-3">★★★★★</div>
            <blockquote class="text-sm text-aloe-700 leading-relaxed mb-4">"{a.texte}"</blockquote>
            <figcaption class="text-sm">
              <span class="font-semibold text-aloe-800">{a.auteur}</span>
              <span class="text-aloe-400 text-xs"> — à propos de {a.produit}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       FAQ — Schema.org FAQPage
  ══════════════════════════════════════════════ -->
  <section class="bg-sand/50 py-20">
    <div class="mx-auto max-w-3xl px-6">
      <div class="text-center mb-10">
        <h2 class="text-4xl text-aloe-900">Questions fréquentes</h2>
      </div>
      <dl class="space-y-4">
        <div class="rounded-2xl bg-white border border-aloe-100 p-6">
          <dt class="font-semibold text-aloe-800 mb-2">Comment commander des produits Forever Living en France ?</dt>
          <dd class="text-sm text-aloe-600 leading-relaxed">
            Commandez directement via notre boutique en ligne sécurisée ou par téléphone au
            <a href="tel:+33677352226" class="text-aloe-600 underline">06 77 35 22 26</a>.
            Livraison en 24–72h partout en France.
          </dd>
        </div>
        <div class="rounded-2xl bg-white border border-aloe-100 p-6">
          <dt class="font-semibold text-aloe-800 mb-2">Les produits Forever Living sont-ils certifiés ?</dt>
          <dd class="text-sm text-aloe-600 leading-relaxed">
            Oui. Tous les produits à base d'Aloe Vera sont certifiés IASC (International Aloe Science
            Council), Kosher et Halal. Fabrication sans tests sur les animaux.
          </dd>
        </div>
        <div class="rounded-2xl bg-white border border-aloe-100 p-6">
          <dt class="font-semibold text-aloe-800 mb-2">Qu'est-ce que le programme C9 Forever ?</dt>
          <dd class="text-sm text-aloe-600 leading-relaxed">
            Le <a href="/produits/programme-c9-forever-vanille-peche/" class="text-aloe-600 underline">programme C9</a> est
            une cure détox de 9 jours à base d'Aloe Vera. Conçu pour nettoyer l'organisme,
            relancer le métabolisme et perdre du poids naturellement.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       CTA FINAL
  ══════════════════════════════════════════════ -->
  <section class="bg-sand py-20">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-4xl text-aloe-900 mb-4">Prêt à prendre soin de vous ?</h2>
      <p class="text-aloe-700 mb-8">
        Découvrez toute notre gamme d'aloe vera ou contactez-nous pour un
        conseil personnalisé. Disponible 7j/7.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/produits/" class="rounded-full bg-aloe-600 px-8 py-3.5 text-sm font-semibold text-cream hover:bg-aloe-700 transition-colors">
          Voir tous les produits
        </a>
        <a href="/contact/" class="rounded-full border border-aloe-400 px-8 py-3.5 text-sm font-semibold text-aloe-700 hover:bg-aloe-50 transition-colors">
          Nous contacter
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
