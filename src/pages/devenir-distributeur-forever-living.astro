---
/**
 * Page Devenir Distributeur Forever Living
 * Layout alterné texte / photo + section témoignages
 * Schema.org : FAQPage + WebPage
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const siteUrl = 'https://espritaloe.fr';
const pageUrl = `${siteUrl}/devenir-distributeur-forever-living/`;

const avantages = [
  {
    icon: "🌍",
    titre: "Une marque mondiale, une opportunité locale",
    texte: "Forever Living Products est présent dans plus de 160 pays depuis 1978. Tu travailles en indépendant, mais avec le soutien d'une structure internationale solide, des outils de vente éprouvés et une gamme de produits qui se vend d'elle-même.",
    photo: "/images/distributeur/pourquoi-choisir-forever-living.webp",
    alt: "Pourquoi choisir Forever Living Products comme activité indépendante",
    sens: "gauche",
  },
  {
    icon: "📦",
    titre: "Des produits que les clients commandent à nouveau",
    texte: "La vraie force d'un business Forever : les clients reviennent. L'aloe vera se consomme quotidiennement. Le programme C9 se fait plusieurs fois par an. Le Forever Freedom s'intègre dans une routine. Ce ne sont pas des achats impulsifs — ce sont des habitudes. Ton revenu se construit sur des clients fidèles, pas sur une chasse permanente aux nouveaux acheteurs.",
    photo: "/images/distributeur/devenir-distributeur-forever-living-produits.webp",
    alt: "Produits Forever Living aloe vera pour distributeurs indépendants",
    sens: "droite",
  },
  {
    icon: "⏱️",
    titre: "Tu décides de ton temps et de ton rythme",
    texte: "Distributeur Forever, ça peut être une activité principale, un complément de revenus, ou simplement un projet à tester. Tu fixes tes horaires, ta zone géographique, ton canal de vente (en ligne, bouche-à-oreille, réseaux sociaux). Aucun patron, aucune obligation de résultat imposée de l'extérieur.",
    photo: "/images/distributeur/devenir-distributeur-forever.webp",
    alt: "Devenir distributeur Forever Living à son propre rythme",
    sens: "gauche",
  },
  {
    icon: "💰",
    titre: "Comment sont construits les revenus",
    texte: "Tu gagnes sur chaque vente directe — une commission sur le prix de vente au détail. Tu bénéficies aussi de bonus liés au volume de ventes et, si tu le souhaites, d'une équipe que tu accompagnes à ton tour. Il n'y a aucune obligation de recruter : beaucoup de distributeurs réussissent très bien en se concentrant uniquement sur les ventes clients.",
    photo: null,
    alt: "Entreprendre avec Forever Living et construire ses revenus",
    sens: "droite",
  },
  {
    icon: "🎓",
    titre: "Formation et accompagnement inclus",
    texte: "Forever Living fournit des outils de vente, des formations produits et business, et un accès à une plateforme de commande en ligne clé en main. De mon côté, je t'accompagne personnellement dans tes premiers pas : choix des produits à présenter, techniques de vente, gestion des clients, développement de ta présence en ligne.",
    photo: "/images/distributeur/formation-forever-living-distributeur.webp",
    alt: "Formation et accompagnement pour distributeurs Forever Living",
    sens: "gauche",
  },
  {
    icon: "🚀",
    titre: "Démarrer ne coûte presque rien",
    texte: "L'investissement de départ est minimal — une adhésion symbolique et quelques produits pour démarrer ta propre expérience. Contrairement à une franchise classique qui nécessite des dizaines de milliers d'euros, tu peux tester sérieusement l'activité Forever Living pour quelques centaines d'euros. Si ça ne te convient pas, tu t'arrêtes — sans perte lourde.",
    photo: "/images/distributeur/assistance-forever-living-distributeur.webp",
    alt: "Assistance et support Forever Living pour démarrer facilement",
    sens: "droite",
  },
];

const temoignages = [
  {
    img: "/images/distributeur/temoignage-forever-manager-leader.webp",
    alt: "Témoignage Sandrine T. Manager Leader Forever Living",
  },
  {
    img: "/images/distributeur/temoignage-forever-manager-senior.webp",
    alt: "Témoignage Anne A. Manager Senior Forever Living",
  },
  {
    img: "/images/distributeur/temoignage-forever-manager.webp",
    alt: "Témoignage Jéromine J. Manager Forever Living",
  },
  {
    img: "/images/distributeur/temoignage-forever-manager-reconnu.webp",
    alt: "Témoignage Daniel E. Manager Reconnu Forever Living",
  },
];

const etapes = [
  { num: "01", titre: "On se parle", texte: "Un appel de 20 minutes pour que je comprenne ta situation, tes objectifs et si l'activité correspond à ce que tu cherches. Aucune pression, aucune obligation." },
  { num: "02", titre: "Tu testes les produits", texte: "Impossible de vendre ce qu'on n'a pas soi-même expérimenté. Je te conseille les produits les plus adaptés à ton profil pour commencer ta propre cure." },
  { num: "03", titre: "Tu démarres officiellement", texte: "Inscription en ligne en quelques minutes. Tu reçois ton kit de démarrage, ton accès à la boutique Forever et tes premiers outils de vente." },
  { num: "04", titre: "Tes premières ventes", texte: "Je t'accompagne sur tes premiers partages, tes premières ventes, ta présence en ligne. L'objectif des 3 premiers mois : rembourser ton investissement de départ." },
];

const faq = [
  {
    q: "Dois-je acheter du stock pour démarrer ?",
    r: "Non. Tu passes tes commandes au fur et à mesure que tes clients achètent. Forever Living livre directement. Tu n'as pas besoin de stocker 100 bouteilles dans ton garage.",
  },
  {
    q: "Faut-il recruter pour gagner de l'argent ?",
    r: "Absolument pas. Tu peux construire un revenu solide uniquement avec des ventes directes à des clients. Le recrutement est une option, pas une obligation.",
  },
  {
    q: "Est-ce vraiment compatible avec un emploi salarié ?",
    r: "Oui. La majorité des distributeurs commencent en activité complémentaire. Tu n'as pas besoin d'y consacrer des heures chaque jour pour obtenir des résultats. 5 à 10h par semaine suffisent pour démarrer.",
  },
  {
    q: "Combien de temps avant les premiers revenus ?",
    r: "Les premiers revenus peuvent intervenir dès le premier mois. Les montants dépendent de ton implication et de ton réseau. Les distributeurs les plus actifs génèrent 500 à 2000 € complémentaires par mois après 6 à 12 mois.",
  },
  {
    q: "Y a-t-il des quotas de vente à respecter ?",
    r: "Non. Il n'y a aucune obligation mensuelle. Tu travailles à ton rythme.",
  },
  {
    q: "Forever Living est-il une franchise ?",
    r: "Non, et c'est une bonne nouvelle pour ton portefeuille. Une franchise classique exige un droit d'entrée de plusieurs dizaines de milliers d'euros, un local et un contrat contraignant. Devenir distributeur (ou revendeur) Forever Living relève de la vente directe : une adhésion symbolique, aucun local, aucun engagement de durée. Tu obtiens les mêmes atouts qu'un franchisé — marque mondiale, produits éprouvés, formation — sans l'investissement lourd.",
  },
  {
    q: "Peut-on devenir distributeur Forever Living en Suisse ou en Belgique ?",
    r: "Oui. Forever Living Products est implanté en Suisse et en Belgique avec ses propres circuits de livraison. Je peux te parrainer et t'accompagner à distance, exactement comme un candidat en France : appel découverte, choix des produits, premiers pas dans l'activité.",
  },
];

const schemaFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, r }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: r },
  })),
};

const schemaWebPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": pageUrl,
  url: pageUrl,
  name: "Devenir Distributeur Forever Living en France",
  description: "Guide complet pour devenir distributeur Forever Living en France, Suisse et Belgique : revenus, fonctionnement, étapes et accompagnement par Rafael Avenard.",
  inLanguage: "fr-FR",
  about: {
    "@type": "Occupation",
    name: "Distributeur Forever Living Products",
    description: "Activité indépendante de vente directe de produits aloe vera certifiés IASC en France.",
  },
  author: {
    "@type": "Person",
    name: "Rafael Avenard",
    jobTitle: "Distributeur Indépendant Forever Living Products",
    telephone: "+33677352226",
  },
};
---

<Layout
  title="Devenir Distributeur Forever Living en France | Esprit Aloé"
  description="Comment devenir distributeur Forever Living en France ou en Suisse ? Revenus, étapes, fonctionnement. Accompagnement personnalisé par Rafael, distributeur FBO."
  canonical={pageUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(schemaWebPage)} slot="head" />

  <Header />

  <!-- ══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <section class="bg-aloe-900 py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <span class="inline-block rounded-full bg-aloe-700 px-4 py-1.5 text-xs font-semibold text-aloe-200 uppercase tracking-widest mb-6">
            Opportunité business
          </span>
          <h1 class="text-4xl md:text-5xl text-cream font-display leading-tight mb-6">
            Devenir distributeur Forever Living —<br />
            <span class="text-aloe-400 italic">tout ce qu'il faut savoir</span>
          </h1>
          <p class="text-lg text-aloe-200 leading-relaxed mb-8">
            Devenir distributeur Forever Living (on dit aussi revendeur ou FBO), c'est lancer une activité indépendante autour de produits aloe vera certifiés que les clients consomment chaque jour — sans stock obligatoire, sans quota, à ton propre rythme. Je suis distributeur Forever en Loire-Atlantique depuis plusieurs années. Voici ce que j'aurais voulu savoir avant de commencer.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="tel:+33677352226"
              class="rounded-full bg-aloe-500 hover:bg-aloe-400 px-7 py-3.5 text-sm font-semibold text-cream transition-colors">
              📞 En parler avec Rafael
            </a>
            <a href="#etapes"
              class="rounded-full border border-aloe-600 hover:border-aloe-400 px-7 py-3.5 text-sm font-semibold text-aloe-200 hover:text-cream transition-colors">
              Voir les étapes →
            </a>
          </div>
        </div>

        <!-- Chiffres clés -->
        <div class="grid grid-cols-2 gap-4">
          <div class="rounded-2xl bg-aloe-800 p-7 text-center">
            <p class="text-4xl font-display text-aloe-300 mb-2">1978</p>
            <p class="text-xs text-aloe-500 uppercase tracking-wide">Fondation Forever Living</p>
          </div>
          <div class="rounded-2xl bg-aloe-800 p-7 text-center">
            <p class="text-4xl font-display text-aloe-300 mb-2">160+</p>
            <p class="text-xs text-aloe-500 uppercase tracking-wide">Pays dans le monde</p>
          </div>
          <div class="rounded-2xl bg-aloe-800 p-7 text-center">
            <p class="text-4xl font-display text-aloe-300 mb-2">9,3<span class="text-2xl">Mds$</span></p>
            <p class="text-xs text-aloe-500 uppercase tracking-wide">Chiffre d'affaires annuel</p>
          </div>
          <div class="rounded-2xl bg-aloe-800 p-7 text-center">
            <p class="text-4xl font-display text-aloe-300 mb-2">0€</p>
            <p class="text-xs text-aloe-500 uppercase tracking-wide">Stock obligatoire</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       INTRO RAFAEL
  ══════════════════════════════════════════ -->
  <section class="bg-cream py-20">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-aloe-500 mb-4">Mon expérience</p>
      <h2 class="text-3xl text-aloe-900 mb-6">Ce que personne ne t'a dit sur l'activité Forever</h2>
      <p class="text-lg text-aloe-700 leading-relaxed mb-6">
        Avant de devenir distributeur, j'avais les mêmes questions que toi. Est-ce que ça marche vraiment ? Combien de temps ça prend ? Est-ce que je vais devoir harceler mes amis pour vendre des produits ?
      </p>
      <p class="text-lg text-aloe-700 leading-relaxed">
        La réalité : les produits Forever se vendent parce qu'ils fonctionnent. Mes clients reviennent parce qu'ils constatent des effets réels. Je n'ai jamais eu à "forcer" une vente. Ce qui prend du temps, c'est de construire la confiance — et ça, je t'explique comment faire.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SECTIONS ALTERNÉES : texte + photo
  ══════════════════════════════════════════ -->
  {avantages.map((item, i) => (
    <section class={`py-20 ${i % 2 === 0 ? 'bg-white' : 'bg-sand/40'}`}>
      <div class="mx-auto max-w-6xl px-6">
        <div class={`grid md:grid-cols-2 gap-16 items-center ${item.sens === 'droite' ? 'md:grid-flow-col' : ''}`}>

          <!-- Texte -->
          <div class={item.sens === 'droite' ? 'md:order-2' : ''}>
            <span class="text-4xl mb-4 block">{item.icon}</span>
            <h2 class="text-2xl md:text-3xl text-aloe-900 font-display mb-5 leading-snug">{item.titre}</h2>
            <p class="text-aloe-700 leading-relaxed text-lg">{item.texte}</p>
          </div>

          <!-- Photo ou placeholder -->
          <div class={item.sens === 'droite' ? 'md:order-1' : ''}>
            {item.photo ? (
              <div class="aspect-square rounded-3xl overflow-hidden shadow-lg border border-aloe-100">
                <img
                  src={item.photo}
                  alt={item.alt}
                  width="600"
                  height="600"
                  loading="lazy"
                  class="w-full h-full object-cover object-top"
                />
              </div>
            ) : (
              <div class="aspect-square rounded-3xl bg-gradient-to-br from-aloe-50 to-aloe-100 border-2 border-dashed border-aloe-200 flex flex-col items-center justify-center text-center p-8">
                <span class="text-5xl mb-4">🌿</span>
                <p class="text-sm font-semibold text-aloe-600">Photo à venir</p>
                <p class="text-xs text-aloe-400 mt-2 leading-relaxed">Une belle image arrive bientôt<br />pour illustrer cette section</p>
              </div>
            )}
          </div>

        </div>
      </div>
    </section>
  ))}

  <!-- ══════════════════════════════════════════
       TÉMOIGNAGES DISTRIBUTEURS — 4 carrés
  ══════════════════════════════════════════ -->
  <section class="bg-aloe-50 py-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-10">
        <span class="text-xs font-semibold uppercase tracking-widest text-aloe-600 mb-2 block">Ils ont fait le pas</span>
        <h2 class="text-3xl text-aloe-900">Ce que disent les distributeurs Forever</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {temoignages.map((t) => (
          <div class="rounded-3xl overflow-hidden shadow-md border border-aloe-100 aspect-square">
            <img
              src={t.img}
              alt={t.alt}
              width="600"
              height="600"
              loading="lazy"
              class="w-full h-full object-cover object-top"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       LES 4 ÉTAPES POUR DÉMARRER
  ══════════════════════════════════════════ -->
  <section id="etapes" class="bg-aloe-900 py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-16">
        <span class="text-xs font-semibold uppercase tracking-widest text-aloe-400 mb-3 block">Comment ça se passe</span>
        <h2 class="text-3xl md:text-4xl text-cream">Démarrer en 4 étapes</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {etapes.map((e) => (
          <div class="rounded-2xl bg-aloe-800 p-8 relative">
            <span class="absolute top-6 right-6 text-4xl font-display text-aloe-700">{e.num}</span>
            <h3 class="text-lg font-semibold text-cream mb-3 pr-10">{e.titre}</h3>
            <p class="text-sm text-aloe-300 leading-relaxed">{e.texte}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-12">
        <a href="tel:+33677352226"
          class="inline-flex items-center gap-2 rounded-full bg-aloe-500 hover:bg-aloe-400 px-10 py-4 text-sm font-semibold text-cream transition-colors">
          📞 Appeler Rafael pour démarrer — 06 77 35 22 26
        </a>
        <p class="text-aloe-500 text-xs mt-4">Appel gratuit, sans engagement. Je réponds à toutes tes questions.</p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       TÉMOIGNAGE RAFAEL (avec photo)
  ══════════════════════════════════════════ -->
  <section class="bg-cream py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div class="aspect-square rounded-3xl overflow-hidden shadow-lg border border-aloe-100">
          <img
            src="/images/distributeur/devenir-distributeur-forever-living.webp"
            alt="Rafael Avenard distributeur Forever Living Loire-Atlantique"
            width="600"
            height="600"
            loading="lazy"
            class="w-full h-full object-cover object-top"
          />
        </div>
        <div>
          <span class="text-xs font-semibold uppercase tracking-widest text-aloe-500 mb-4 block">Le mot de Rafael</span>
          <h2 class="text-3xl text-aloe-900 font-display mb-6">Pourquoi j'ai choisi Forever Living</h2>
          <blockquote class="border-l-4 border-aloe-300 pl-6 mb-8">
            <p class="text-lg text-aloe-700 leading-relaxed italic mb-4">
              "Je cherchais une activité que je pouvais développer à mon rythme, avec des produits en lesquels je croyais vraiment. L'aloe vera m'a convaincu d'abord par ses effets sur ma propre santé. Ensuite, en voyant mes clients revenir commande après commande, j'ai compris que j'avais trouvé quelque chose de solide."
            </p>
            <footer class="text-sm font-semibold text-aloe-800">Rafael Avenard, distributeur Forever Loire-Atlantique</footer>
          </blockquote>
          <div class="flex flex-wrap gap-4">
            <a href="tel:+33677352226"
              class="rounded-full bg-aloe-600 hover:bg-aloe-700 px-7 py-3.5 text-sm font-semibold text-cream transition-colors">
              📞 06 77 35 22 26
            </a>
            <a href="mailto:contact@espritaloe.fr"
              class="rounded-full border border-aloe-300 px-7 py-3.5 text-sm font-semibold text-aloe-700 hover:bg-aloe-50 transition-colors">
              ✉️ Écrire à Rafael
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       FAQ
  ══════════════════════════════════════════ -->
  <section class="bg-sand/50 py-20">
    <div class="mx-auto max-w-3xl px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl text-aloe-900">Questions fréquentes</h2>
      </div>
      <dl class="space-y-4">
        {faq.map(({ q, r }) => (
          <div class="rounded-2xl bg-white border border-aloe-100 p-6">
            <dt class="font-semibold text-aloe-800 mb-2">{q}</dt>
            <dd class="text-sm text-aloe-600 leading-relaxed">{r}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       POUR ALLER PLUS LOIN — maillage blog
  ══════════════════════════════════════════ -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="text-2xl text-aloe-900 text-center mb-8">Pour aller plus loin</h2>
      <div class="grid sm:grid-cols-2 gap-5">
        <a href="/blog/forever-living-franchise-ou-vente-directe/" class="block rounded-2xl border border-aloe-100 bg-cream/60 p-6 hover:border-aloe-300 hover:shadow-md transition-all">
          <span class="text-2xl block mb-3">🏪</span>
          <h3 class="font-semibold text-aloe-800 mb-2 leading-snug">Forever Living est-il une franchise ?</h3>
          <p class="text-sm text-aloe-600 leading-relaxed">Franchise vs vente directe : coûts, engagement, liberté. Le comparatif complet.</p>
          <span class="text-xs font-semibold text-aloe-500 mt-3 inline-block">Lire l'article →</span>
        </a>
        <a href="/blog/fbo-forever-living-comment-ca-marche/" class="block rounded-2xl border border-aloe-100 bg-cream/60 p-6 hover:border-aloe-300 hover:shadow-md transition-all">
          <span class="text-2xl block mb-3">🌿</span>
          <h3 class="font-semibold text-aloe-800 mb-2 leading-snug">FBO Forever : qu'est-ce que c'est ?</h3>
          <p class="text-sm text-aloe-600 leading-relaxed">Définition, différence avec un client, niveaux et inscription en France.</p>
          <span class="text-xs font-semibold text-aloe-500 mt-3 inline-block">Lire l'article →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       CTA FINAL
  ══════════════════════════════════════════ -->
  <section class="bg-aloe-800 py-20">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl text-cream mb-4">Prêt à en savoir plus ?</h2>
      <p class="text-aloe-200 leading-relaxed mb-8 text-lg">
        Un appel de 20 minutes suffit pour répondre à toutes tes questions et voir si l'activité Forever correspond à ton projet.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="tel:+33677352226"
          class="rounded-full bg-aloe-500 hover:bg-aloe-400 px-10 py-4 text-sm font-semibold text-cream transition-colors">
          📞 Appeler — 06 77 35 22 26
        </a>
        <a href="/contact/"
          class="rounded-full border border-aloe-500 hover:border-aloe-300 px-10 py-4 text-sm font-semibold text-aloe-200 hover:text-cream transition-colors">
          ✉️ Envoyer un message
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
