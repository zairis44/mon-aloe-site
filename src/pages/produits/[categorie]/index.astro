---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CtaCommander from '../../../components/CtaCommander.astro';
import GuidesLies from '../../../components/GuidesLies.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const tous = await getCollection('produits');

  const parCategorie: Record<string, typeof tous> = {};
  for (const produit of tous) {
    const cat = (produit.data as any).category as string;
    if (!cat) continue;
    if (!parCategorie[cat]) parCategorie[cat] = [];
    parCategorie[cat].push(produit);
  }

  return Object.entries(parCategorie).map(([categorie, produits]) => ({
    params: { categorie },
    props: { produits },
  }));
}

const { categorie } = Astro.params;
const { produits } = Astro.props as { produits: any[] };

const config: Record<string, { label: string; icon: string; desc: string; couleur: string; guide?: string }> = {
  'boissons-aloe-vera': {
    label: "Boissons Aloe Vera",
    icon: "🥤",
    desc: "Pulpe d'aloe vera pure, boissons enrichies et coffrets pour votre bien-être intérieur.",
    couleur: "from-aloe-50 to-aloe-100",
  },
  'programmes-detox': {
    label: "Programmes Détox",
    icon: "🔄",
    desc: "Les programmes C9 (9 jours), DX4 (4 jours) et F15 (15 jours) pour cadrer votre alimentation, avec un objectif de perte de poids.",
    couleur: "from-sand to-aloe-50",
    guide: `
      <h2>C9, DX4 ou F15 : lequel choisir ?</h2>
      <p>Ces trois programmes associent des boissons à l'aloe vera, des shakes protéinés, des compléments et une alimentation encadrée. Ce qui les distingue, c'est leur durée et leur place dans votre parcours.</p>
      <ul>
        <li><strong>Le programme C9 (9 jours)</strong> est le plus connu et le plus complet : un guide jour par jour, une phase plus stricte au début, puis la réintroduction des repas. C'est le point de départ classique. Tout est détaillé dans le <a href="/blog/programme-c9-forever-guide-cure-detox-9-jours/">guide du programme C9</a>, et vous pouvez suivre ma propre cure dans <a href="/mon-journal-c9/">mon journal C9</a>.</li>
        <li><strong>Le programme DX4 (4 jours)</strong> est plus court : il convient si vous voulez une coupure brève plutôt qu'un programme de plus d'une semaine.</li>
        <li><strong>Les programmes F15 (15 jours)</strong> prennent le relais après le C9, en trois niveaux (Débutant, Intermédiaire, Avancé), pour installer de nouvelles habitudes dans la durée.</li>
      </ul>
      <p>Un mot sur le terme « détox » : votre foie et vos reins éliminent les déchets en permanence, sans cure. Ce que ces programmes changent, c'est votre alimentation pendant quelques jours, dans un cadre précis.</p>
      <p><strong>Grossesse, allaitement, diabète, traitement en cours :</strong> demandez l'avis de votre médecin avant de commencer. Et si vous hésitez entre deux programmes, <a href="/contact/">écrivez-moi</a> : je vous aide à choisir selon votre objectif.</p>
    `,
  },
  'sport-et-fitness': {
    label: "Sport & Fitness",
    icon: "💪",
    desc: "Shakes, barres et compléments pour accompagner vos entraînements et votre récupération.",
    couleur: "from-aloe-100 to-aloe-200",
    guide: `
      <h2>Quel produit pour votre pratique ?</h2>
      <p>Ces produits accompagnent une routine d'entraînement. Ils ne remplacent ni une alimentation suffisante, ni l'hydratation, ni le sommeil, qui restent la base de la récupération.</p>
      <ul>
        <li><strong>Forever Lite Ultra</strong> (vanille ou chocolat) : un shake protéiné en poudre, pratique après la séance ou en collation quand le temps manque.</li>
        <li><strong>Forever Fast Break</strong> : une barre à emporter, pour une collation avant ou après l'effort.</li>
        <li><strong>Forever ARGI+</strong> : 5 g de L-arginine par stick, avec des vitamines B6, B12 et C qui contribuent à réduire la fatigue. Sans caféine. Déconseillé pendant la grossesse, l'allaitement et sous anticoagulant.</li>
        <li><strong>Forever Therm</strong> : des comprimés au thé vert et au guarana, avec des vitamines. Il contient de la caféine : à éviter le soir et si vous y êtes sensible.</li>
      </ul>
      <p>Pour le confort articulaire, le <a href="/produits/forever-freedom-confort-articulaire/">Forever Freedom</a> se trouve dans les boissons aloe vera. Pour savoir comment les sportifs intègrent l'aloe vera à leur routine, lisez <a href="/blog/aloe-vera-sport-recuperation-musculaire/">Aloe vera et sport</a>. Vous hésitez ? <a href="/contact/">Écrivez-moi</a>, je vous conseille selon votre sport.</p>
    `,
  },
  'nutrition': {
    label: "Nutrition",
    icon: "🌱",
    desc: "Vitamines, oméga-3, produits de la ruche et plantes : les compléments alimentaires Forever pour compléter une alimentation variée.",
    couleur: "from-aloe-50 to-cream",
    guide: `
      <h2>Comment choisir un complément Forever ?</h2>
      <p>Un complément alimentaire complète une alimentation variée, il ne la remplace pas. Avant d'en choisir un, demandez-vous ce qui manque vraiment dans votre assiette, et gardez en tête qu'un multivitamine et une vitamine C prises ensemble font souvent doublon.</p>
      <ul>
        <li><strong>Pour une base complète</strong> : Forever Daily réunit vitamines et minéraux en 2 comprimés par jour.</li>
        <li><strong>Pour la vitamine C seule</strong> : Absorbent-C, un comprimé à croquer par jour.</li>
        <li><strong>Pour les oméga-3</strong> : Forever Arctic Sea, à base d'huiles de poisson et de calamar, si vous mangez peu de poissons gras.</li>
        <li><strong>Pour les produits de la ruche</strong> : Bee Pollen (pollen et miel) ou Royal Jelly (gelée royale). À éviter si vous êtes allergique aux produits de la ruche.</li>
      </ul>
      <p><strong>Grossesse, allaitement, traitement en cours, enfants :</strong> plusieurs de ces produits sont déconseillés dans ces situations. Chaque fiche détaille ses précautions : lisez-les, et demandez l'avis de votre médecin ou de votre pharmacien en cas de doute. Vous hésitez ? <a href="/contact/">Écrivez-moi</a>.</p>
    `,
  },
  'cremes-et-gels': {
    label: "Beauté & Bien-être",
    icon: "🧴",
    desc: "Gels, crèmes et savons naturels à base d'aloe vera pour prendre soin de vous.",
    couleur: "from-cream to-sand",
  },
};

const info = config[categorie] ?? {
  label: categorie,
  icon: "🌿",
  desc: "",
  couleur: "from-aloe-50 to-aloe-100",
};

const siteUrl = 'https://espritaloe.fr';
const pageUrl = `${siteUrl}/produits/${categorie}/`;

const schemaCollectionPage = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": pageUrl,
  name: `${info.label} Forever Living`,
  description: info.desc,
  url: pageUrl,
  inLanguage: "fr-FR",
  isPartOf: { "@id": `${siteUrl}/#website` },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: `${siteUrl}/` },
      { "@type": "ListItem", position: 2, name: "Produits", item: `${siteUrl}/produits/` },
      { "@type": "ListItem", position: 3, name: info.label, item: pageUrl },
    ],
  },
};

const schemaItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `${info.label} Forever Living — Esprit Aloé`,
  url: pageUrl,
  numberOfItems: produits.length,
  itemListElement: produits.map((p: any, i: number) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Product",
      name: p.data.name,
      url: `${siteUrl}/produits/${p.data.slug}/`,
      image: p.data.image ? `${siteUrl}${p.data.image}` : undefined,
      offers: {
        "@type": "Offer",
        price: Number(p.data.price).toFixed(2),
        priceCurrency: "EUR",
        availability: "https://schema.org/InStock",
      },
    },
  })),
};
---

<Layout
  title={`${info.label} Forever Living | Esprit Aloé`}
  description={`${info.desc} Produits ${info.label} Forever Living livrés en France en 48–72h.`}
  canonical={pageUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaCollectionPage)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(schemaItemList)} slot="head" />

  <Header />

  <!-- En-tête catégorie -->
  <section class={`bg-gradient-to-br ${info.couleur} py-16`}>
    <div class="mx-auto max-w-6xl px-6">
      <nav class="text-xs text-aloe-400 mb-6" aria-label="Fil d'Ariane">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-aloe-600 transition-colors">Accueil</a></li>
          <li>›</li>
          <li><a href="/produits/" class="hover:text-aloe-600 transition-colors">Produits</a></li>
          <li>›</li>
          <li class="text-aloe-700 font-medium">{info.label}</li>
        </ol>
      </nav>
      <div class="flex items-center gap-4 mb-4">
        <span class="text-5xl">{info.icon}</span>
        <h1 class="text-4xl md:text-5xl text-aloe-900">{info.label}</h1>
      </div>
      <p class="text-lg text-aloe-600 max-w-2xl">{info.desc}</p>
    </div>
  </section>

  <!-- Grille produits -->
  <section class="bg-cream py-16">
    <div class="mx-auto max-w-6xl px-6">
      {produits.length === 0 ? (
        <div class="text-center py-20">
          <span class="text-5xl">{info.icon}</span>
          <p class="text-xl text-aloe-400 mt-4 mb-6">Aucun produit dans cette catégorie.</p>
          <a href="/contact/" class="rounded-full bg-aloe-600 px-6 py-3 text-sm font-semibold text-cream hover:bg-aloe-700 transition-colors">
            Nous contacter
          </a>
        </div>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {produits.map((produit: any) => {
            const d = produit.data as any;
            const slug = d.slug || produit.id || produit.slug;
            return (
              <article class="group rounded-3xl bg-white border border-aloe-100 overflow-hidden hover:shadow-xl hover:shadow-aloe-900/10 transition-all">
                <a href={`/produits/${slug}/`} class="block">
                  <div class="aspect-square bg-white flex items-center justify-center overflow-hidden p-4">
                    {d.image ? (
                      <img
                        src={d.image}
                        alt={d.name}
                        width="400"
                        height="300"
                        loading="lazy"
                        class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
                      />
                    ) : (
                      <span class="text-6xl">{info.icon}</span>
                    )}
                  </div>
                </a>
                <div class="p-6">
                  <h2 class="text-base font-semibold text-aloe-800 mb-3 leading-snug line-clamp-2">
                    <a href={`/produits/${slug}/`} class="hover:text-aloe-600 transition-colors">
                      {d.name}
                    </a>
                  </h2>
                  <div class="flex items-center justify-between mb-3">
                    <span class="text-lg font-display text-aloe-700">
                      {Number(d.price).toFixed(2)} €
                    </span>
                  </div>
                  <div class="flex items-start gap-2">
                    <a
                      href={`/produits/${slug}/`}
                      class="flex-1 inline-flex items-center justify-center rounded-full border border-aloe-300 px-3 py-2.5 text-sm font-semibold text-aloe-700 hover:bg-aloe-50 transition-colors whitespace-nowrap"
                    >
                      Voir →
                    </a>
                    {d.lienCommande && (
                      <div class="flex-1">
                        <CtaCommander lienCommande={d.lienCommande} size="sm" fullWidth label="🛒 Commander" />
                      </div>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>

  {info.guide && (
    <section class="bg-white py-14">
      <div class="guide-categorie mx-auto max-w-3xl px-6 text-aloe-700 leading-relaxed" set:html={info.guide} />
    </section>
  )}

  <GuidesLies categorie={categorie} titre="Nos guides pour bien choisir" />

  <!-- Autres catégories -->
  <section class="bg-sand/50 py-12">
    <div class="mx-auto max-w-6xl px-6">
      <p class="text-xs font-semibold uppercase tracking-widest text-aloe-400 mb-4 text-center">
        Explorer d'autres gammes
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        {Object.entries(config)
          .filter(([slug]) => slug !== categorie)
          .map(([slug, cat]) => (
            <a
              href={`/produits/${slug}/`}
              class="flex items-center gap-2 rounded-full border border-aloe-200 bg-white px-4 py-2 text-sm font-medium text-aloe-600 hover:bg-aloe-50 transition-colors"
            >
              <span>{cat.icon}</span>
              <span>{cat.label}</span>
            </a>
          ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .guide-categorie :global(h2) { font-size: 1.75rem; color: var(--color-aloe-900, #1a3123); margin-bottom: 1rem; }
  .guide-categorie :global(p) { margin-bottom: 1rem; }
  .guide-categorie :global(ul) { list-style: disc; padding-left: 1.25rem; margin-bottom: 1rem; }
  .guide-categorie :global(li) { margin-bottom: .6rem; }
  .guide-categorie :global(a) { text-decoration: underline; text-underline-offset: 3px; color: var(--color-aloe-800, #1f3c29); }
</style>
