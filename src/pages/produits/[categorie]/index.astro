---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const tous = await getCollection('produits');

  // Grouper les produits par leur vraie valeur de category
  const parCategorie: Record<string, typeof tous> = {};
  for (const produit of tous) {
    const cat = (produit.data as any).category as string;
    if (!cat) continue;
    if (!parCategorie[cat]) parCategorie[cat] = [];
    parCategorie[cat].push(produit);
  }

  return Object.entries(parCategorie).map(([categorie, produits]) => ({
    params: { categorie },
    props: { produits },
  }));
}

const { categorie } = Astro.params;
const { produits } = Astro.props as { produits: any[] };

const config: Record<string, { label: string; icon: string; desc: string; couleur: string }> = {
  'boissons-aloe-vera': {
    label: "Boissons Aloe Vera",
    icon: "🥤",
    desc: "Pulpe d'aloe vera pure, boissons enrichies et coffrets pour votre bien-être intérieur.",
    couleur: "from-aloe-50 to-aloe-100",
  },
  'programmes-detox': {
    label: "Programmes Détox",
    icon: "🔄",
    desc: "Le C9 (9 jours) et DX4 (4 jours) pour relancer naturellement votre métabolisme.",
    couleur: "from-sand to-aloe-50",
  },
  'sport-et-fitness': {
    label: "Sport & Fitness",
    icon: "💪",
    desc: "Compléments naturels pour vos performances et votre récupération musculaire.",
    couleur: "from-aloe-100 to-aloe-200",
  },
  'cremes-et-gels': {
    label: "Beauté & Bien-être",
    icon: "🧴",
    desc: "Gels, crèmes et savons naturels à base d'aloe vera pour prendre soin de vous.",
    couleur: "from-cream to-sand",
  },
  'nutrition': {
    label: "Nutrition",
    icon: "🌱",
    desc: "Compléments alimentaires naturels certifiés IASC pour votre santé au quotidien.",
    couleur: "from-aloe-50 to-cream",
  },
};

const info = config[categorie] ?? {
  label: categorie,
  icon: "🌿",
  desc: "",
  couleur: "from-aloe-50 to-aloe-100",
};
---

<Layout
  title={`${info.label} Forever Living | Esprit Aloé`}
  description={`${info.desc} Produits ${info.label} Forever Living livrés en France en 24-72h.`}
  canonical={`https://espritaloe.fr/produits/${categorie}/`}
>
  <Header />

  <!-- En-tête catégorie -->
  <section class={`bg-gradient-to-br ${info.couleur} py-16`}>
    <div class="mx-auto max-w-6xl px-6">
      <nav class="text-xs text-aloe-400 mb-6" aria-label="Fil d'Ariane">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-aloe-600 transition-colors">Accueil</a></li>
          <li>›</li>
          <li><a href="/produits/" class="hover:text-aloe-600 transition-colors">Produits</a></li>
          <li>›</li>
          <li class="text-aloe-700 font-medium">{info.label}</li>
        </ol>
      </nav>
      <div class="flex items-center gap-4 mb-4">
        <span class="text-5xl">{info.icon}</span>
        <h1 class="text-4xl md:text-5xl text-aloe-900">{info.label}</h1>
      </div>
      <p class="text-lg text-aloe-600 max-w-2xl">{info.desc}</p>
    </div>
  </section>

  <!-- Grille produits -->
  <section class="bg-cream py-16">
    <div class="mx-auto max-w-6xl px-6">
      {produits.length === 0 ? (
        <div class="text-center py-20">
          <span class="text-5xl">{info.icon}</span>
          <p class="text-xl text-aloe-400 mt-4 mb-6">Aucun produit dans cette catégorie.</p>
          <a href="/contact/" class="rounded-full bg-aloe-600 px-6 py-3 text-sm font-semibold text-cream hover:bg-aloe-700 transition-colors">
            Nous contacter
          </a>
        </div>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {produits.map((produit: any) => {
            const d = produit.data as any;
            const slug = d.slug || produit.id || produit.slug;
            return (
              <article class="group rounded-3xl bg-white border border-aloe-100 overflow-hidden hover:shadow-xl hover:shadow-aloe-900/10 transition-all">
                <a href={`/produits/${slug}/`} class="block">
                  <div class="aspect-[4/3] bg-gradient-to-br from-aloe-50 to-aloe-100 flex items-center justify-center overflow-hidden">
                    {d.image ? (
                      <img
                        src={d.image}
                        alt={d.name}
                        width="400"
                        height="300"
                        loading="lazy"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      />
                    ) : (
                      <span class="text-6xl">{info.icon}</span>
                    )}
                  </div>
                </a>
                <div class="p-6">
                  <h2 class="text-base font-semibold text-aloe-800 mb-3 leading-snug line-clamp-2">
                    <a href={`/produits/${slug}/`} class="hover:text-aloe-600 transition-colors">
                      {d.name}
                    </a>
                  </h2>
                  <div class="flex items-center justify-between">
                    <span class="text-lg font-display text-aloe-700">
                      {Number(d.price).toFixed(2)} €
                    </span>
                    <a
                      href={`/produits/${slug}/`}
                      class="rounded-full bg-aloe-600 px-4 py-2 text-xs font-semibold text-cream hover:bg-aloe-700 transition-colors"
                    >
                      Voir →
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <!-- Autres catégories -->
  <section class="bg-sand/50 py-12">
    <div class="mx-auto max-w-6xl px-6">
      <p class="text-xs font-semibold uppercase tracking-widest text-aloe-400 mb-4 text-center">
        Explorer d'autres gammes
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        {Object.entries(config)
          .filter(([slug]) => slug !== categorie)
          .map(([slug, cat]) => (
            <a
              href={`/produits/${slug}/`}
              class="flex items-center gap-2 rounded-full border border-aloe-200 bg-white px-4 py-2 text-sm font-medium text-aloe-600 hover:bg-aloe-50 transition-colors"
            >
              <span>{cat.icon}</span>
              <span>{cat.label}</span>
            </a>
          ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
