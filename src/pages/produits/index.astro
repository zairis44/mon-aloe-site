---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const produits = await getCollection('produits');

const categories = [
  { slug: 'boissons-aloe-vera', label: 'Boissons Aloe Vera', emoji: '🥤' },
  { slug: 'programme-detox', label: 'Programmes Détox', emoji: '✨' },
  { slug: 'sport-et-fitness', label: 'Sport et Fitness', emoji: '💪' },
  { slug: 'cremes-et-gels', label: 'Crèmes et Gels', emoji: '🧴' },
  { slug: 'nutrition', label: 'Nutrition', emoji: '🌱' },
];

const produitsParCat = categories.map((cat) => ({
  ...cat,
  items: produits
    .filter((p) => p.data.category === cat.slug)
    .sort((a, b) => a.data.name.localeCompare(b.data.name)),
}));
---

<Layout
  title="Tous les produits Aloe Vera Forever | Mon Aloe Vera Bien-être"
  description="Parcourez toute la gamme Forever Living : boissons aloe vera, programmes détox C9 & DX4, soins beauté, compléments sportifs et nutrition."
>
  <Header />

  <!-- En-tête -->
  <section class="bg-gradient-to-br from-aloe-50 to-cream py-16">
    <div class="mx-auto max-w-6xl px-6 text-center">
      <h1 class="text-4xl md:text-5xl text-aloe-900 mb-4">Nos produits Aloe Vera</h1>
      <p class="text-aloe-700 max-w-xl mx-auto">
        Toute la gamme Forever Living, des boissons à l'aloe vera aux programmes
        détox et soins naturels.
      </p>
    </div>
  </section>

  <!-- Produits par catégorie -->
  {produitsParCat.map((cat) =>
    cat.items.length > 0 ? (
      <section class="py-14 even:bg-sand/40">
        <div class="mx-auto max-w-6xl px-6">
          <h2 class="text-2xl md:text-3xl text-aloe-900 mb-8 flex items-center gap-3">
            <span>{cat.emoji}</span> {cat.label}
            <span class="text-sm font-body text-aloe-400">({cat.items.length})</span>
          </h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {cat.items.map((p) => (
              <a
                href={`/produits/${p.id}`}
                class="group rounded-3xl bg-white border border-aloe-100 overflow-hidden hover:shadow-xl hover:shadow-aloe-900/10 transition-all"
              >
                <div class="aspect-square bg-gradient-to-br from-aloe-50 to-aloe-100 flex items-center justify-center p-6">
                  <img
                    src={p.data.image}
                    alt={p.data.name}
                    class="max-h-full w-auto object-contain group-hover:scale-105 transition-transform"
                    loading="lazy"
                  />
                </div>
                <div class="p-5">
                  <h3 class="text-base text-aloe-800 leading-snug line-clamp-2 min-h-12">
                    {p.data.name}
                  </h3>
                  <div class="mt-3 flex items-center justify-between">
                    <span class="text-lg font-display text-aloe-700">
                      {p.data.price.toFixed(2).replace('.', ',')} €
                    </span>
                    <span class="text-sm font-semibold text-aloe-500 group-hover:text-aloe-700">
                      Voir →
                    </span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    ) : null
  )}

  <Footer />
</Layout>
