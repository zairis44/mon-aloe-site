---
/**
 * src/pages/a-propos.astro
 * Page À propos — Esprit Aloé
 * E-E-A-T + Schema.org Person
 * Photo : /public/images/rafael-avenard.jpg
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const siteUrl = 'https://espritaloe.fr';

const schemaPerson = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  url: `${siteUrl}/a-propos/`,
  name: "À propos — Rafael Avenard, distributeur Forever Living",
  mainEntity: {
    "@type": "Person",
    name: "Rafael Avenard",
    jobTitle: "Distributeur Indépendant Forever Living Products",
    description: "Passionné de bien-être naturel, Rafael accompagne ses clients dans leur démarche santé grâce aux produits Forever Living depuis plusieurs années.",
    telephone: "+33677352226",
    email: "contact@espritaloe.fr",
    url: `${siteUrl}/a-propos/`,
    knowsAbout: ["Aloe Vera", "Compléments alimentaires naturels", "Forever Living Products", "Programmes détox"],
  },
};

const valeurs = [
  {
    icon: "🌿",
    titre: "Naturalité",
    texte: "Je crois sincèrement au pouvoir des plantes. L'aloe vera est utilisée depuis des millénaires — Forever Living s'est contenté d'en extraire le meilleur.",
  },
  {
    icon: "🔬",
    titre: "Qualité certifiée",
    texte: "Tous les produits sont certifiés IASC. Zéro compromis sur la pureté et la traçabilité.",
  },
  {
    icon: "🤝",
    titre: "Conseil humain",
    texte: "Je ne vends pas des produits : j'accompagne des personnes. Un échange téléphonique vaut mieux qu'une fiche produit générique.",
  },
  {
    icon: "📦",
    titre: "Service fiable",
    texte: "Livraison partout en France en 24–72h, disponible 7j/7, satisfait ou remboursé 30 jours.",
  },
];

const certifications = [
  { label: "Certifié IASC", detail: "International Aloe Science Council — garantie pureté aloe vera" },
  { label: "Sans tests animaux", detail: "Forever Living s'engage depuis 1978 contre les tests sur animaux" },
];
---

<Layout
  title="À propos de Rafael Avenard — Distributeur Forever Living France | Esprit Aloé"
  description="Découvrez Rafael Avenard, distributeur indépendant Forever Living Products en France. Passionné de bien-être naturel, disponible 7j/7 pour vous conseiller sur les produits aloe vera."
  canonical={`${siteUrl}/a-propos/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaPerson)} slot="head" />

  <Header />

  <!-- EN-TÊTE -->
  <section class="bg-gradient-to-br from-aloe-50 via-cream to-sand py-16">
    <div class="mx-auto max-w-6xl px-6">
      <nav class="text-xs text-aloe-400 mb-6" aria-label="Fil d'Ariane">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-aloe-600 transition-colors">Accueil</a></li>
          <li>›</li>
          <li class="text-aloe-700 font-medium">À propos</li>
        </ol>
      </nav>
      <h1 class="text-5xl text-aloe-900 mb-4">À propos<br />d'Esprit Aloé</h1>
      <p class="text-lg text-aloe-600 max-w-xl leading-relaxed">
        Derrière Esprit Aloé, il y a une personne réelle — Rafael Avenard — distributeur
        indépendant Forever Living Products, passionné par le bien-être naturel.
      </p>
    </div>
  </section>

  <!-- PROFIL RAFAEL -->
  <section class="bg-cream py-20">
    <div class="mx-auto max-w-6xl px-6 grid md:grid-cols-2 gap-14 items-center">

      <!-- Photo -->
      <div class="flex justify-center">
        <div class="relative">
          <div class="w-72 h-72 rounded-[2.5rem] overflow-hidden shadow-2xl shadow-aloe-900/20 bg-gradient-to-br from-aloe-400 to-aloe-700">
            <img
              src="/images/rafael-avenard.webp"
              alt="Rafael Avenard, distributeur Forever Living Products"
              width="288"
              height="288"
              loading="eager"
              class="w-full h-full object-cover"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <!-- Fallback si la photo n'est pas encore en place -->
            <div style="display:none" class="w-full h-full items-center justify-center bg-gradient-to-br from-aloe-400 to-aloe-700">
              <span class="text-6xl font-bold text-cream">RA</span>
            </div>
          </div>
          <!-- Badge -->
          <div class="absolute -bottom-4 -right-4 bg-white rounded-2xl px-4 py-3 shadow-xl border border-aloe-100">
            <p class="text-xs font-semibold text-aloe-700 uppercase tracking-wide">Distributeur</p>
            <p class="text-xs text-aloe-500">Forever Living Products</p>
          </div>
        </div>
      </div>

      <!-- Bio -->
      <div>
        <span class="inline-block rounded-full bg-aloe-100 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-aloe-700 mb-6">
          Rafael Avenard
        </span>
        <h2 class="text-3xl text-aloe-900 mb-5 leading-tight">
          Un distributeur indépendant<br />à votre service
        </h2>
        <div class="space-y-4 text-aloe-700 leading-relaxed">
          <p>
            Chez Esprit Aloé, vous ne traitez pas avec une enseigne anonyme. Je suis
            <strong>Rafael Avenard</strong>, entrepreneur indépendant et partenaire de la société
            Forever Living Products depuis plusieurs années.
          </p>
          <p>
            Ma démarche est simple : vous proposer les meilleurs produits à base d'aloe vera
            que je connais et consomme moi-même, avec un accompagnement <strong>humain et personnalisé</strong>.
            Pas de script de vente, pas de promesses exagérées — juste des conseils honnêtes
            adaptés à vos besoins.
          </p>
          <p>
            Que vous cherchiez à améliorer votre digestion, prendre soin de votre peau,
            retrouver de l'énergie ou vous lancer dans une cure détox, je suis disponible
            <strong>7j/7</strong> pour vous orienter vers la solution la plus adaptée.
          </p>
        </div>

        <!-- Contacts -->
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="tel:+33677352226"
            class="inline-flex items-center gap-2 rounded-full bg-aloe-600 px-5 py-3 text-sm font-semibold text-cream hover:bg-aloe-700 transition-colors"
          >
            📞 06 77 35 22 26
          </a>
          <a
            href="mailto:contact@espritaloe.fr"
            class="inline-flex items-center gap-2 rounded-full border border-aloe-300 px-5 py-3 text-sm font-semibold text-aloe-700 hover:bg-aloe-50 transition-colors"
          >
            ✉️ contact@espritaloe.fr
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- VALEURS -->
  <section class="bg-sand/50 py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-12">
        <h2 class="text-4xl text-aloe-900">Ce en quoi je crois</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {valeurs.map((v) => (
          <div class="rounded-2xl bg-white border border-aloe-100 p-7">
            <span class="text-3xl block mb-4">{v.icon}</span>
            <h3 class="font-semibold text-aloe-800 mb-2">{v.titre}</h3>
            <p class="text-sm text-aloe-600 leading-relaxed">{v.texte}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FOREVER LIVING -->
  <section class="bg-aloe-800 text-cream py-20">
    <div class="mx-auto max-w-5xl px-6 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl text-cream mb-5">Forever Living Products</h2>
        <p class="text-aloe-100 leading-relaxed mb-4">
          Fondée en <strong class="text-cream">1978 en Arizona (États-Unis)</strong>, Forever Living Products
          est aujourd'hui l'une des plus grandes entreprises mondiales spécialisées dans la
          culture, la transformation et la distribution de produits à base d'aloe vera.
        </p>
        <p class="text-aloe-100 leading-relaxed mb-4">
          L'entreprise contrôle l'intégralité de la chaîne : de la plantation à la mise en flacon,
          garantissant une traçabilité totale et une <strong class="text-cream">pureté certifiée IASC</strong>.
        </p>
        <p class="text-aloe-100 leading-relaxed">
          En tant que distributeur indépendant, je ne suis pas salarié de Forever Living.
          Je suis un entrepreneur autonome qui choisit librement les produits qu'il recommande
          — ce qui, à mes yeux, renforce la sincérité de mes conseils.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        {certifications.map((c) => (
          <div class="rounded-2xl bg-aloe-700 p-5">
            <p class="font-semibold text-cream text-sm mb-1">{c.label}</p>
            <p class="text-xs text-aloe-200 leading-relaxed">{c.detail}</p>
          </div>
        ))}
        <div class="col-span-2 rounded-2xl bg-aloe-700 p-5">
          <p class="font-semibold text-cream text-sm mb-1">+45 ans d'expertise</p>
          <p class="text-xs text-aloe-200 leading-relaxed">Forever Living Products, fondé en Arizona en 1978 — présent dans plus de 160 pays</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-cream py-16">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl text-aloe-900 mb-4">Prêt à commencer votre démarche bien-être ?</h2>
      <p class="text-aloe-600 mb-8">
        Contactez-moi pour un conseil personnalisé, sans engagement.
        Je réponds sous 24h maximum.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/produits/" class="rounded-full bg-aloe-600 px-8 py-3.5 text-sm font-semibold text-cream hover:bg-aloe-700 transition-colors">
          Découvrir les produits
        </a>
        <a href="/contact/" class="rounded-full border border-aloe-300 px-8 py-3.5 text-sm font-semibold text-aloe-700 hover:bg-aloe-50 transition-colors">
          Nous contacter
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
