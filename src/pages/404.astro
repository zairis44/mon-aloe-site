---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page en construction | Esprit Aloé"
  description="Cette page arrive bientôt. Découvrez dès maintenant nos produits Aloe Vera Forever Living."
  noindex={true}
>
  <Header />

  <section class="bg-gradient-to-br from-aloe-50 via-cream to-sand min-h-[70vh] flex items-center">
    <div class="mx-auto max-w-2xl px-6 py-20 text-center">

      <span class="text-7xl mb-8 block animate-bounce">🌿</span>

      <h1 class="text-4xl md:text-5xl text-aloe-900 mb-4">
        Page en construction
      </h1>

      <p class="text-lg text-aloe-600 leading-relaxed mb-10">
        Cette page est bientôt disponible. En attendant, découvrez
        nos produits Aloe Vera ou contactez-nous directement.
      </p>

      <div class="flex flex-wrap gap-4 justify-center mb-14">
        <a
          href="/produits/"
          class="rounded-full bg-aloe-600 px-7 py-3.5 text-sm font-semibold text-cream hover:bg-aloe-700 transition-colors"
        >
          Voir les produits
        </a>
        <a
          href="/contact/"
          class="rounded-full border border-aloe-300 px-7 py-3.5 text-sm font-semibold text-aloe-700 hover:bg-aloe-50 transition-colors"
        >
          Nous contacter
        </a>
        <a
          href="/"
          class="rounded-full border border-aloe-300 px-7 py-3.5 text-sm font-semibold text-aloe-700 hover:bg-aloe-50 transition-colors"
        >
          ← Accueil
        </a>
      </div>

      <!-- Accès rapide catégories -->
      <div class="border-t border-aloe-100 pt-10">
        <p class="text-xs font-semibold uppercase tracking-widest text-aloe-400 mb-5">
          Nos catégories
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          {[
            { href: "/produits/boissons-aloe-vera/", label: "🥤 Boissons" },
            { href: "/produits/programmes-detox/", label: "🔄 Programmes Détox" },
            { href: "/produits/sport-et-fitness/", label: "💪 Sport & Fitness" },
            { href: "/produits/cremes-et-gels/", label: "🧴 Beauté" },
            { href: "/produits/nutrition/", label: "🌱 Nutrition" },
          ].map((cat) => (
            <a
              href={cat.href}
              class="rounded-full border border-aloe-200 bg-white px-4 py-2 text-sm text-aloe-600 hover:bg-aloe-50 transition-colors"
            >
              {cat.label}
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
