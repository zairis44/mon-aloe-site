# Copier ce fichier en .env et remplir. Le .env est ignore par git.

# --- Search Console -------------------------------------------------
# Propriete telle qu'elle apparait dans la Search Console.
# Propriete de domaine :  sc-domain:espritaloe.fr
# Prefixe d'URL        :  https://espritaloe.fr/
GSC_SITE_URL=sc-domain:espritaloe.fr

# Chemin ABSOLU vers la cle JSON du compte de service.
# A garder HORS du repo et hors OneDrive.
GSC_KEY_FILE=C:\Users\rafae\.secrets\gsc-service-account.json

# --- Notifications Telegram (facultatif) ----------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
